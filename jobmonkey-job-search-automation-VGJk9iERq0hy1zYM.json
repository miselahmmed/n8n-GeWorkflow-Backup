 }},</p>\n\n<p>We're writing to let you know that there was an issue processing your recent JobMonkey request.</p>\n\n<p><strong>Reason:</strong> {{ $json.reason }}</p>\n\n<p>This can sometimes happen if no jobs matching your criteria were found, or if the jobs found were not a strong match for your resume after being scored by the AI.</p>\n\n<p>Not to worry, a refund for this request has been processed automatically.</p>\n\n<p>You are welcome to try again with a different job title or an updated resume. If you continue to experience issues, please don't hesitate to contact support by replying this email or gerald@dominixai.com.</p>\n\n<p>Thanks,<br>The JobMonkey Team</p>","options":{"appendAttribution":false}},"type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[4112,896],"id":"3360994d-3efb-4fc8-ba8a-21f77341a7b4","name":"Send Failure Email","webhookId":"a149d79d-e4d7-42c6-bbc4-f6a625c06ef2","credentials":{"smtp":{"id":"QG1kbwZBcXAe5VV3","name":"gerald@jobmonkey.dev"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"d32fb6e6-a6a6-49ab-87a8-212bf055c7b2","leftValue":"={{ $json.job_title }}","rightValue":"","operator":{"type":"string","operation":"notEmpty","singleValue":true}},{"id":"d79d5dc9-f3ca-44d1-801f-fa3b2ba3b7f3","leftValue":"={{ $json.company_name }}","rightValue":"","operator":{"type":"string","operation":"notEmpty","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.filter","typeVersion":2.2,"position":[-64,400],"id":"6307d007-9072-4452-9a4a-dce041c0c4d1","name":"Filter Out Bad Data"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"bd5a9af0-b569-4a75-9744-20699a5021d0","leftValue":"={{ Number(JSON.parse($json.output.replace(/```(json)?\\n|```/g, '')).score) }}","rightValue":3,"operator":{"type":"number","operation":"gte"}}],"combinator":"and"},"looseTypeValidation":true,"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1376,576],"id":"3d2674a1-fb02-4694-b78b-f65d695f8557","name":"📈 IF Score ≥ 3","alwaysOutputData":true},{"parameters":{"amount":10},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[1680,560],"id":"0295f420-bf20-401f-b137-bd9dd7e7d74f","name":"Wait1","webhookId":"6dcb9ddf-8e96-4b49-aa55-aa46695848ae"},{"parameters":{"model":{"__rl":true,"value":"o3","mode":"list","cachedResultName":"o3"},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.2,"position":[1136,880],"id":"445dd491-d3f7-48cb-867a-ffd1f4919e45","name":"OpenAI Chat Model1","credentials":{"openAiApi":{"id":"ySmjTBAwyTsi9kbr","name":"OpenAi account 1"}},"disabled":true},{"parameters":{"promptType":"define","text":"=As an expert hiring manager, analyze the Job Description and Candidate Resume.\n\n### JOB DESCRIPTION\n{{ $json.job_description }}\n\n### CANDIDATE RESUME\n{{ $('Extract from File').item.json.text }}\n\n### INSTRUCTIONS\nReturn a single JSON object with two keys: \"skills\" and \"score\".\n- \"skills\": An array of the top skills from the job description.\n- \"score\": A number from 1 to 5 indicating how well the resume matches the job skills.\n\nExample Output:\n{\n  \"skills\": [\"Project Management\", \"Agile Methodologies\", \"JIRA\"],\n  \"score\": 4\n}","options":{}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":2,"position":[1040,576],"id":"15b90897-c13b-4ba8-888b-d93d464b0526","name":"Score Resume Match to Extracted Skills from Job Description","executeOnce":false},{"parameters":{"promptType":"define","text":"=You are an expert career writer. Based on the Job Description and the Candidate's Resume, perform the following two tasks.\n\n### ROLE DETAILS\n- Job Title: {{ $('Loop Over Items').item.json.job_title }}\n- Company: {{ $('Loop Over Items').item.json.company_name }}\n\n### CANDIDATE RESUME\n{{ $('Extract from File').item.json.text }}\n\n### INSTRUCTIONS\nFirst, rewrite the resume as a clean HTML fragment optimized for this job.\nSecond, write a persuasive, ATS-friendly cover letter as an HTML fragment for this job.\n\nStructure your entire response with the following clear headings so I can parse it easily. Do not include any other text or explanation.\n\n### REWRITTEN RESUME ###\n[The full rewritten resume HTML goes here]\n\n### COVER LETTER ###\n[The full cover letter HTML goes here]","messages":{"messageValues":[{"message":"You are an expert and helpful career writer"}]},"batching":{}},"type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.7,"position":[1888,560],"id":"60f25108-431d-4d5c-85d4-ec163f4501a3","name":"🔥Write Cover Letter & Rewrite Resume1"},{"parameters":{"jsCode":"// This code cleans and safely parses the LLM output.\n\n// Get the full output from the LLM node\nconst llmOutput = $('🔥Write Cover Letter & Rewrite Resume1').item.json.text;\n\n// Check if the LLM output is empty and handle it\nif (!llmOutput) {\n  return [{\n    json: {\n      ...$('Loop Over Items').item.json, // Keep original job data\n      tailored_resume: 'Error: Resume could not be generated because LLM output was empty.',\n      cover_letter: 'Error: Cover letter could not be generated because LLM output was empty.',\n    }\n  }];\n}\n\n// Clean up the output by removing markdown code blocks and extra whitespace\nconst cleanedOutput = llmOutput.replace(/```(html)?\\\\n|```/g, '').trim();\n\n// Split the output into two parts based on the headings\nconst parts = cleanedOutput.split('### COVER LETTER ###');\n\n// Extract the resume and remove its heading\nconst resumeHtml = parts[0].replace('### REWRITTEN RESUME ###', '').trim();\n\n// **FIX:** Safely extract the cover letter only if it exists\nconst coverLetterHtml = parts.length > 1 ? parts[1].trim() : 'Cover letter was not generated.';\n\n// Return the job data with the new, correctly separated properties\nreturn [{\n  json: {\n    job_title: $('Loop Over Items').item.json.job_title || \"Title Not Found\",\n    company_name: $('Loop Over Items').item.json.company_name || \"Company Not Found\",\n    job_url: $('Loop Over Items').item.json.job_url || \"#\",\n    job_description: $('Loop Over Items').item.json.job_description,\n    email: $('Webhook').item.json.body.email,\n    cover_letter: coverLetterHtml,\n    tailored_resume: resumeHtml\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2224,560],"id":"d4fd81e4-41ac-4b0a-9e9f-fcad492e6329","name":"Split cover letter from resume"},{"parameters":{"jsCode":"// Debug version - collect all jobs after loop completes\nconsole.log(\"=== COLLECTING ALL JOBS ===\");\n\ntry {\n  // Get all processed jobs from \"Prepare Final Job\" node\n  const jobResults = $items(\"Prepare Final Job\");\n  console.log(\"Total items from Prepare Final Job:\", jobResults.length);\n  \n  const allJobs = [];\n  jobResults.forEach((item, index) => {\n    if (item && item.json) {\n      console.log(`Job ${index + 1}:`, item.json.job_title);\n      allJobs.push({\n        job_title: item.json.job_title || \"Title Not Found\",\n        company_name: item.json.company_name || \"Company Not Found\",\n        job_url: item.json.job_url || \"#\",\n        job_description: item.json.job_description || \"No description\",\n        cover_letter: item.json.cover_letter || \"Cover letter not available\",\n        tailored_resume: item.json.tailored_resume || \"Resume not available\",\n        email: item.json.email || \"\"\n      });\n    }\n  });\n  \n  console.log(\"FINAL RESULT: Collected\", allJobs.length, \"jobs\");\n  \n  return [{\n    json: {\n      jobs: allJobs,\n      totalProcessed: allJobs.length\n    }\n  }];\n  \n} catch (error) {\n  console.log(\"Collection error:\", error.message);\n  return [{\n    json: {\n      jobs: [],\n      totalProcessed: 0,\n      error: error.message\n    }\n  }];\n}"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1952,320],"id":"3190def0-ddd8-4b4e-bff4-bc201dae099d","name":"Collect jobs into one array"},{"parameters":{"assignments":{"assignments":[{"id":"b8e5d118-e34e-4e15-a3b1-27c313438720","name":"collection_ready","value":true,"type":"boolean"},{"id":"473aa8f5-36ce-4e4b-8e3c-979b519c7f3a","name":"total_jobs_processed","value":"={{ $('Loop Over Items').item.json.batchSize || 0 }}","type":"number"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1216,320],"id":"bfc5cdab-d6e6-4b0b-956b-d2e77ec37d6d","name":"Gather jobs before sending"},{"parameters":{"model":"deepseek/deepseek-chat-v3.1:free","options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenRouter","typeVersion":1,"position":[912,784],"id":"61a4dd8b-35ed-4070-9f98-7b6058147954","name":"OpenRouter Chat Model","credentials":{"openRouterApi":{"id":"5PDv0ZxYOLkxlcrr","name":"OpenRouter account"}}},{"parameters":{"model":{"__rl":true,"value":"o3","mode":"list","cachedResultName":"o3"},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.2,"position":[1840,832],"id":"48ed9913-03c6-4525-a978-efc9d5767294","name":"OpenAI Chat Model","credentials":{"openAiApi":{"id":"ySmjTBAwyTsi9kbr","name":"OpenAi account 1"}}},{"parameters":{"model":{"__rl":true,"value":"claude-3-haiku-20240307","mode":"list","cachedResultName":"Claude Haiku 3"},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatAnthropic","typeVersion":1.3,"position":[2464,1248],"id":"5ab18fc9-0a71-4bbb-949d-062a75b9ca8f","name":"Anthropic Chat Model","credentials":{"anthropicApi":{"id":"pvdBPeu56Ea5mKrO","name":"Anthropic API account"}},"disabled":true}],"connections":{"Filter Duplicates":{"main":[[{"node":"Job Feed Limiter","type":"main","index":0}]]},"Upate sheets":{"main":[[{"node":"Wait","type":"main","index":0}]]},"Extract from File":{"main":[[{"node":"Set Job Title","type":"main","index":0}]]},"Apify: Run Indeed Scraper":{"main":[[{"node":"Apify: Get Indeed Results","type":"main","index":0}]]},"Apify: Get Indeed Results":{"main":[[{"node":"Merge","