{"createdAt":"2025-08-29T07:55:26.489Z","updatedAt":"2025-08-29T08:00:54.000Z","id":"u40HT4F0pxUfZSWK","name":"Adzuna (CA)/JobMonkey Job Search Automation","active":true,"isArchived":false,"nodes":[{"parameters":{"operation":"pdf","binaryPropertyName":"data0","options":{}},"type":"n8n-nodes-base.extractFromFile","typeVersion":1,"position":[-1168,2736],"id":"56f13f42-7e85-4367-b04a-46a51c4f6732","name":"Extract from File"},{"parameters":{"respondWith":"text","responseBody":"{\n  \"status\": \"success\",\n  \"message\": \"Request received. Job search and other processes are now ongoing in the background. Depending on the number of jobs being processed, this may take up to 5 or more minutes.The results will be sent to your mailbox. Thank you- The JobMonky Team\"\n}","options":{"responseHeaders":{"entries":[{"name":"Content-Type","value":"application/json"}]}}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[-1344,2736],"id":"bdc41d4f-7562-42c7-82d2-56864ea958ea","name":"Respond to Webhook"},{"parameters":{"content":"## Step 1: Get Request from User=>\n\n","height":1120,"width":820,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-1616,2224],"typeVersion":1,"id":"3445197c-b0d3-4d47-a5cc-bdbb7be6bbca","name":"Sticky Note"},{"parameters":{"assignments":{"assignments":[{"id":"99d327d4-7bed-4b76-9150-75247e4eaf0f","name":"job_title","value":"={{ $('Webhook').item.json.body.jobSearchKeyword }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-960,2736],"id":"bc00231f-e2bd-40eb-b886-e607543b155e","name":"Set Job Title"},{"parameters":{"content":"# Need Help?\n\n# Reach me: https://www.linkedin.com/in/gerald-akhidenor-1ab1a45/ #\n\n# Work with me: https://dominixai.com/ #\n\n# My website: https://jobmonkey.dev #\n\n# My email: denorgerald@gmail.com #\n","height":480,"width":1000,"color":4},"type":"n8n-nodes-base.stickyNote","position":[1088,1360],"typeVersion":1,"id":"907b4c68-c213-4c40-9899-bb602cea856e","name":"Sticky Note1"},{"parameters":{"httpMethod":"POST","path":"adzuna_ca","responseMode":"responseNode","options":{"binaryPropertyName":"data"}},"type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-1536,2736],"id":"928d002e-a831-4cfd-9b3a-5b7715866afe","name":"Webhook","webhookId":"cae20423-1ac7-4d32-9366-547a45bd76ce"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"bd5a9af0-b569-4a75-9744-20699a5021d0","leftValue":"={{ Number(JSON.parse($json.output.replace(/```(json)?\\n|```/g, '')).score) }}","rightValue":3,"operator":{"type":"number","operation":"gte"}}],"combinator":"and"},"looseTypeValidation":true,"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[2224,2848],"id":"ae1dce69-111c-49ad-a7cb-481348504e37","name":"📈 IF Score ≥ 3","alwaysOutputData":true},{"parameters":{"amount":10},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[2528,2832],"id":"f9f2c9b4-ba47-4292-937c-51c57acff7c4","name":"Wait1","webhookId":"73185ea1-c3e1-4e10-960f-54cd26703203"},{"parameters":{"model":{"__rl":true,"value":"o3","mode":"list","cachedResultName":"o3"},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.2,"position":[2864,3136],"id":"f1e1c05e-74f7-4388-a397-20f3b669bfda","name":"OpenAI Chat Model","credentials":{"openAiApi":{"id":"ySmjTBAwyTsi9kbr","name":"OpenAi account 1"}}},{"parameters":{"promptType":"define","text":"=As an expert hiring manager, analyze the Job Description and Candidate Resume.\n\n### JOB DESCRIPTION\n{{ $json.job_description }}\n\n### CANDIDATE RESUME\n{{ $('Extract from File').item.json.text }}\n\n### INSTRUCTIONS\nReturn a single JSON object with two keys: \"skills\" and \"score\".\n- \"skills\": An array of the top skills from the job description.\n- \"score\": A number from 1 to 5 indicating how well the resume matches the job skills.\n\nExample Output:\n{\n  \"skills\": [\"Project Management\", \"Agile Methodologies\", \"JIRA\"],\n  \"score\": 4\n}","options":{}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":2,"position":[1888,2848],"id":"78e1085f-051c-437b-9446-751692b3120c","name":"Score Resume Match to Extracted Skills from Job Description","executeOnce":false},{"parameters":{"promptType":"define","text":"=You are an expert career writer. Based on the Job Description and the Candidate's Resume, perform the following two tasks.\n\n### ROLE DETAILS\n- Job Title: {{ $('Loop Over Items').item.json.job_title }}\n- Company: {{ $('Loop Over Items').item.json.company_name }}\n\n### CANDIDATE RESUME\n{{ $('Extract from File').item.json.text }}\n\n### INSTRUCTIONS\nFirst, rewrite the resume as a clean HTML fragment optimized for this job.\nSecond, write a persuasive, ATS-friendly cover letter as an HTML fragment for this job.\n\nStructure your entire response with the following clear headings so I can parse it easily. Do not include any other text or explanation.\n\n### REWRITTEN RESUME ###\n[The full rewritten resume HTML goes here]\n\n### COVER LETTER ###\n[The full cover letter HTML goes here]","messages":{"messageValues":[{"message":"You are an expert and helpful career writer"}]},"batching":{}},"type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.7,"position":[2736,2832],"id":"cdaf129e-8adc-46c2-bb3a-de197a8e50fd","name":"🔥Write Cover Letter & Rewrite Resume1"},{"parameters":{"jsCode":"// This code goes inside the \"Split cover letter from resume\" node.\n// It cleans and correctly parses the LLM output.\n\n// Get the full output from the LLM node\nconst llmOutput = $('🔥Write Cover Letter & Rewrite Resume1').item.json.text;\n\n// Clean up the output by removing the markdown code blocks and extra whitespace\nconst cleanedOutput = llmOutput.replace(/```(html)?\\n|```/g, '').trim();\n\n// Split the output into two parts based on the headings\nconst parts = cleanedOutput.split('### COVER LETTER ###');\n\n// Extract the resume and remove the resume heading\nconst resumeHtml = parts[0].replace('### REWRITTEN RESUME ###', '').trim();\n\n// Extract the cover letter and remove any extra whitespace\nconst coverLetterHtml = parts[1].trim();\n\n// Return the job data with the new, correctly separated properties\nreturn [{\n  json: {\n    job_title: $('Loop Over Items').item.json.job_title || \"Title Not Found\",\n    company_name: $('Loop Over Items').item.json.company_name || \"Company Not Found\",\n    job_url: $('Loop Over Items').item.json.job_url || \"#\",\n    job_description: $('Loop Over Items').item.json.job_description,\n    email: $('Webhook').item.json.body.email,\n    cover_letter: coverLetterHtml,\n    tailored_resume: resumeHtml\n  }\n}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[3072,2832],"id":"5e2193b8-51c8-4e75-81c3-a7fef62ae60e","name":"Split cover letter from resume"},{"parameters":{"jsCode":"// Debug version - collect all jobs after loop completes\nconsole.log(\"=== COLLECTING ALL JOBS ===\");\n\ntry {\n  // Get all processed jobs from \"Prepare Final Job\" node\n  const jobResults = $items(\"Prepare Final Job\");\n  console.log(\"Total items from Prepare Final Job:\", jobResults.length);\n  \n  const allJobs = [];\n  jobResults.forEach((item, index) => {\n    if (item && item.json) {\n      console.log(`Job ${index + 1}:`, item.json.job_title);\n      allJobs.push({\n        job_title: item.json.job_title || \"Title Not Found\",\n        company_name: item.json.company_name || \"Company Not Found\",\n        job_url: item.json.job_url || \"#\",\n        job_description: item.json.job_description || \"No description\",\n        cover_letter: item.json.cover_letter || \"Cover letter not available\",\n        tailored_resume: item.json.tailored_resume || \"Resume not available\",\n        email: item.json.email || \"\"\n      });\n    }\n  });\n  \n  console.log(\"FINAL RESULT: Collected\", allJobs.length, \"jobs\");\n  \n  return [{\n    json: {\n      jobs: allJobs,\n      totalProcessed: allJobs.length\n    }\n  }];\n  \n} catch (error) {\n  console.log(\"Collection error:\", error.message);\n  return [{\n    json: {\n      jobs: [],\n      totalProcessed: 0,\n      error: error.message\n    }\n  }];\n}"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2800,2592],"id":"992b50f9-ab2d-453d-9577-3def67b6751b","name":"Collect jobs into one array"},{"parameters":{"assignments":{"assignments":[{"id":"b8e5d118-e34e-4e15-a3b1-27c313438720","name":"collection_ready","value":true,"type":"boolean"},{"id":"473aa8f5-36ce-4e4b-8e3c-979b519c7f3a","name":"total_jobs_processed","value":"={{ $('Loop Over Items').item.json.batchSize || 0 }}","type":"number"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[2064,2592],"id":"746dacbe-7916-470d-ac0d-1d45debdaad5","name":"Gather jobs before sending"},{"parameters":{"content":"## Step 3: Analyze Job, Match Resume to Job and Write a Customized Resume for the New Job=>","height":1140,"width":3480,"color":4},"type":"n8n-nodes-base.stickyNote","position":[288,2224],"typeVersion":1,"id":"52984a36-f670-4f1a-b34d-72272a920e65","name":"Sticky Note5"},{"parameters":{"resource":"Datasets","datasetId":"={{ $json.defaultDatasetId }}","offset":{}},"type":"@apify/n8n-nodes-apify.apify","typeVersion":1,"position":[-256,3104],"id":"3020b197-f843-439f-a168-fc1aae026fa2","name":"Apify: Get Glassdoor Results1","credentials":{"apifyApi":{"id":"2xcqVAa5VnPvmUtO","name":"Apify API denorgerald"}},"disabled":true,"onError":"continueRegularOutput"},{"parameters":{"content":"## Step 4: Feedback to User=>\n","height":1140,"width":1460,"color":4},"type":"n8n-nodes-base.stickyNote","position":[3792,2224],"typeVersion":1,"id":"6b0a05c5-6411-4e4d-bb1d-33f4cef1ab02","name":"Sticky Note6"},{"parameters":{"content":"## Step 2: Retrieve Job Data from Various job Boards Via API=>\n","height":1120,"width":1040,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-768,2224],"typeVersion":1,"id":"175044aa-0d24-45e7-967d-68a5045e5923","name":"Sticky Note3"},{"parameters":{"options":{}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[1440,2672],"id":"456a31b8-7345-4572-a951-3fa339cd0bc9","name":"Loop Over Items"},{"parameters":{"jsCode":"// Set the maximum number of jobs you want to process.\nconst maxJobs = 10;\n\n// This line takes the full list of jobs and returns only the first 15.\nreturn items.slice(0, maxJobs);"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1232,2672],"id":"79a5aec5-d44a-45f4-bdc5-3cd32e6497b8","name":"Job Feed Limiter"},{"parameters":{"jsCode":"const seen = new Set();\n\nfunction normalizeText(text) {\n  return text.toLowerCase()\n    .trim()\n    .replace(/[^\\w\\s]/g, '') // Remove special characters\n    .replace(/\\s+/g, ' ');   // Normalize whitespace\n}\n\nreturn items.filter(item => {\n  const job = item.json;\n  \n  // Extract with fallbacks and normalize\n  const title = normalizeText(\n    job.title || job.jobTitle || job.job_title || job.name || \n    job.position || job.positionTitle || job.role || job.jobName ||\n    job.job?.title || ''\n  );\n  \n  const company = normalizeText(\n    job.company || job.companyName || job.company_name || \n    job.employer || job.organization || job.job?.company || ''\n  );\n  \n  const description = normalizeText(\n    (job.description || job.jobDescription || job.job_description || \n     job.summary || job.details || job.job?.description || '')\n    .substring(0, 100)\n  );\n  \n  // Skip if we don't have enough data to create a meaningful key\n  if (!title && !company) {\n    return true; // Keep items we can't properly identify\n  }\n  \n  const key = `${title}-${company}-${description}`;\n  \n  if (seen.has(key)) {\n    return false;\n  }\n  seen.add(key);\n  return true;\n});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1008,2672],"id":"5ec2dbe0-59c5-46ed-b7a8-3c0719ddfae2","name":"Filter Duplicates"},{"parameters":{"conditions":{"options":{"caseSensitiv