layName":"status","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"cover_letter","displayName":"cover_letter","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"row_number","displayName":"row_number","required":false,"defaultMatch":false,"display":true,"type":"number","canBeUsedToMatch":true,"readOnly":true,"removed":true}],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.6,"position":[3536,2832],"id":"5570fb72-3706-44c3-bb8c-64199a531147","name":"Upate sheets","alwaysOutputData":true,"credentials":{"googleSheetsOAuth2Api":{"id":"M9hAVeUu4zs26iIe","name":"Google Sheets account"}}},{"parameters":{},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[3792,2912],"id":"41dfb32a-6d58-4d2c-8a40-9f5775f4655d","name":"Wait","webhookId":"142bdb0b-6389-4d63-b0ef-65b96c887bce"},{"parameters":{"jsCode":"// Safer approach to access data\nconst inputData = $input.all();\nconsole.log(\"Input data received:\", inputData.length, \"items\");\n\nif (inputData.length === 0) {\n  return [{\n    json: {\n      status: 'failure',\n      reason: 'No data received from collection node'\n    }\n  }];\n}\n\nconst collectedData = inputData[0].json;\nconsole.log(\"Collected data structure:\", Object.keys(collectedData));\n\nconst successfulJobs = collectedData.jobs || [];\nconsole.log(\"Jobs found:\", successfulJobs.length);\n\n// Get webhook data using items() instead of accessing directly\nconst webhookItems = $items(\"Webhook\");\nconst webhookData = webhookItems[0].json;\nconst userEmail = webhookData.body.email;\nconst userName = webhookData.body.name;\nconst transactionId = webhookData.body.transactionId;\nconst submissionId = webhookData.body.submissionId;\n\n// Rest of your email building logic stays the same...\nif (successfulJobs.length === 0) {\n  return [{\n    json: {\n      status: 'failure',\n      reason: 'No matching jobs were found to process after filtering.',\n      userEmail,\n      userName,\n      transactionId,\n      submissionId\n    }\n  }];\n}\n\n// Build email HTML (keeping your existing code)\nlet emailHtml = `\n<html>\n  <body style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333;\">\n    <p>Hi ${userName},</p>\n    <p>Your JobMonkey request is complete! Here are the tailored resume(s) and cover letter(s) for the ${successfulJobs.length} job(s) that was/were successfully processed:</p>\n`;\n\nlet jobCounter = 1;\nfor (const jobData of successfulJobs) {\n  const jobTitle = jobData.job_title || 'Title Not Available';\n  const companyName = jobData.company_name || jobData.company || 'Company Not Available';\n  const jobUrl = jobData.job_url || '#';\n  const coverLetter = jobData.cover_letter || 'Cover letter not available';\n  const tailoredResume = jobData.tailored_resume || 'Resume not available';\n\n  emailHtml += `\n    <hr style=\"margin: 30px 0; border: 1px solid #ccc;\">\n    <h2>Job #${jobCounter}: ${jobTitle} at ${companyName}</h2>\n    <p><strong>Job URL:</strong> <a href=\"${jobUrl}\">${jobUrl}</a></p>\n    \n    <h3>Your Cover Letter:</h3>\n    <div style=\"background: #f9f9f9; padding: 15px; border: 1px solid #eee; border-radius: 8px; margin-bottom: 15px;\">\n      ${coverLetter}\n    </div>\n    \n    <h3>Your Tailored Resume:</h3>\n    <div style=\"background: #f9f9f9; padding: 15px; border: 1px solid #eee; border-radius: 8px;\">\n      ${tailoredResume}\n    </div>\n  `;\n  jobCounter++;\n}\n\nemailHtml += `\n    <hr style=\"margin-top: 30px;\">\n    <p>Good luck with your applications!</p>\n    <p>The JobMonkey Team</p>\n  </body>\n</html>\n`;\n\nreturn [{\n  json: {\n    finalEmailBody: emailHtml,\n    userEmail,\n    userName,\n    status: 'success',\n    submissionId\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[4080,2592],"id":"5f6e1d93-dc88-4c47-8f1d-f