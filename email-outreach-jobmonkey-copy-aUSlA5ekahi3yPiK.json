font-size: 18px; font-weight: bold; margin-bottom: 20px; color: #2c3e50; }\n        .dynamic-content { font-size: 16px; margin-bottom: 25px; white-space: pre-wrap; }\n        .features { background-color: #f8f9fa; border-radius: 8px; padding: 25px; margin: 25px 0; }\n        .feature-item { display: flex; align-items: flex-start; margin-bottom: 15px; font-size: 16px; }\n        .feature-item:last-child { margin-bottom: 0; }\n        .feature-bullet { color: #667eea; font-weight: bold; margin-right: 10px; font-size: 18px; }\n        .value-prop { background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%); border-radius: 8px; padding: 20px; text-align: center; margin: 25px 0; font-size: 18px; font-weight: 600; color: #8b4513; }\n        .cta-container { text-align: center; margin: 30px 0; }\n        .cta-button { display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white !important; padding: 15px 30px; text-decoration: none; border-radius: 25px; font-size: 18px; font-weight: bold; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); }\n        .free-points { background-color: #fff3cd; border: 2px dashed #ffc107; border-radius: 8px; padding: 15px; text-align: center; margin: 20px 0; font-size: 16px; font-weight: bold; color: #856404; }\n        .closing { text-align: center; margin: 25px 0; font-size: 16px; font-weight: 600; color: #2c3e50; }\n        .signature { border-top: 2px solid #e9ecef; padding-top: 20px; text-align: center; }\n        .team-name { font-size: 18px; font-weight: bold; color: #2c3e50; margin-bottom: 5px; }\n        .tagline { font-size: 14px; color: #6c757d; font-style: italic; margin-bottom: 20px; }\n        .contact-info { background-color: #f8f9fa; border-radius: 8px; padding: 15px; margin-top: 15px; }\n        .contact-item { margin: 8px 0; font-size: 14px; }\n        .contact-item a { color: #667eea; text-decoration: none; font-weight: 500; }\n        .emoji { font-size: 20px; margin-right: 8px; }\n        @media screen and (max-width: 600px) {\n            .header h1 { font-size: 24px; }\n            .content { padding: 20px 15px; }\n            .cta-button { padding: 12px 25px; font-size: 16px; }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"email-container\">\n        <div class=\"header\">\n            <h1>🐵 JobMonkey.dev</h1>\n        </div>\n        \n        <div class=\"content\">\n            <div class=\"greeting\">Hi {{ $('Loop Over Items').item.json.firstname || 'there' }},</div>\n            \n            <div class=\"dynamic-content\">\n                {{ $('email template selector').item.json.content.trim() }}\n          </div>\n            \n            <div class=\"features\">\n                <div class=\"feature-item\">\n                    <span class=\"feature-bullet\">🎯</span>\n                    <div><strong>Auto-apply to dozens of jobs in 1 click.</strong></div>\n                </div>\n                <div class=\"feature-item\">\n                    <span class=\"feature-bullet\">🚀</span>\n                    <div><strong>Optimize your resume with AI to match jobs</strong> so that recruiters actually notice you.</div>\n                </div>\n                <div class=\"feature-item\">\n                    <span class=\"feature-bullet\">🎭</span>\n                    <div><strong>Practice mock interviews with AI</strong> that trains you to crush the real thing.</div>\n                </div>\n                <div class=\"feature-item\">\n                    <span class=\"feature-bullet\">📋</span>\n                    <div><strong>Let RésuméDoc diagnose your resume</strong> and position it to match with recruiters' expectations.</div>\n                </div>\n            </div>\n            \n            <div class=\"value-prop\">\n                <span class=\"emoji\">💡</span>\n                Imagine waking up to fresh interview invites in your inbox. That's what JobMonkey does.\n            </div>\n            \n          