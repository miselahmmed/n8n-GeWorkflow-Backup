our writing style and personality: {{ $('Webhook Trigger').item.json.body.llm_profile }}\n\nYour task: Convert YouTube video transcripts into compelling LinkedIn posts that drive engagement.\n\nGuidelines:\n- Start with a catchy, scroll-stopping hook that makes people want to read more\n- Extract the most valuable insights, lessons, or takeaways from the content\n- Write in a conversational yet professional tone\n- Keep it concise and punchy - no fluff or unnecessary words\n- Structure: Hook → Key insights → Actionable takeaway or thought-provoking conclusion\n- Make it feel personal and relatable, but generalized (don't mention specific video creators)\n- Focus on universal principles and lessons that apply broadly\n- NO hashtags\n- Aim for 150-300 words depending on content richness\n- Use line breaks for readability\n- End with something that encourages engagement (question, call to action, or thought-provoker)\n\nRemember: You're not summarizing the video - you're extracting wisdom and presenting it as your own professional insight.","role":"system"},{"content":"=Please convert this YouTube transcript into an engaging LinkedIn post:\n\n{{ $json.transcripts.map(segment => segment.text).join(' ') }}"}]},"options":{}},"id":"4b66305a-24ce-4e5c-a539-377df024190f","name":"Generate LinkedIn Post","type":"@n8n/n8n-nodes-langchain.openAi","typeVersion":1.3,"position":[20,-80],"credentials":{"openAiApi":{"id":"ySmjTBAwyTsi9kbr","name":"OpenAi account 1"}}},{"parameters":{"respondWith":"text","responseBody":"={{ $json.message.content }}","options":{}},"id":"95111ae2-7d9c-42c3-9c7c-e5baab761efb","name":"Success Response","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[380,-80]},{"parameters":{"respondWith":"json","responseBody":{"success":false,"error":"No transcript available for this video","video_id":"={{ $('Webhook Trigger').item.json.video_id }}","available_languages":"={{ $json.available_languages || [] }}"},"options":{}},"id":"40f6be0f-54f0-41e