4be55d9a3%23ec0b4a5b-3c37-434f-8455-a1fe7f8413d0%22%2C%22%24sesid%22%3A%5B1753443458577%2C%220198414d-1f76-72f9-87f4-063aef308b53%22%2C1753442230134%5D%2C%22%24epp%22%3Atrue%2C%22%24initial_person_info%22%3A%7B%22r%22%3A%22%24direct%22%2C%22u%22%3A%22http%3A%2F%2Flocalhost%3A5678%2Fsignout%22%7D%7D","upgrade-insecure-requests":"1","sec-fetch-dest":"document","sec-fetch-mode":"navigate","sec-fetch-site":"same-origin","sec-fetch-user":"?1","priority":"u=0, i"},"params":{},"query":{},"body":{"jobRole":"Software engineer","userEmail":"denorgerald@gmail.com","resumeText":"LILIAN ANYANWU\r\nMain Vision Eye Clinic Ejims Plaza, \r\n13 Trans-Amadi Rumubiakani Port Harcourt Rivers State, Nigeria\r\n    Email: esumelilian8@gmail.com\r\n________________________________________\r\nCareer Objective (Professional Summary)\r\nCustomer Service & Sales Professional with over 6 years of experience across healthcare, beauty, and technology sectors. Proven track record of driving customer engagement, increasing retention, and exceeding revenue targets through proactive communication and effective lead nurturing. Adept at using tools like WhatsApp and Shopify to manage high volumes of customer interactions and streamline service delivery. Committed to delivering exceptional service and contributing to organizational growth through reliable support and persuasive communication.\r\n________________________________________\r\nSkills\r\nCore Competencies & Tools\r\n•\tCustomer Relationship Management (CRM)\r\n•\tLead Nurturing & Conversion\r\n•\tAppointment Reminders & Follow-Up\r\n•\tSales Target Achievement (₦1M+/mo)\r\n•\tCustomer Complaint Resolution\r\n•\tWhatsApp Business Communication\r\n•\tShopify Order Management\r\n•\tSocial Media Sales (Instagram, Facebook)\r\n•\tVerbal & Written Communication\r\n•\tTeam Training & Mentorship\r\n•\tCompetitive Benchmarking\r\n•\tPrice Auditing & Sales Reporting\r\n________________________________________\r\nWork Experience\r\nCustomer Service Representative\r\nMain Vision Eye Clinic – Feb 2025 – Present\r\nEjims Plaza, Trans Amadi Road, Rumuobioakani\r\n•\tNurture and follow up with over 50 patient leads weekly via phone and WhatsApp, guiding them from inquiry to appointment and post-visit engagement.\r\n•\tSend timely appointment reminders and follow-ups, reducing no-show rates and increasing patient attendance.\r\n•\tPersuade hesitant leads to complete their transactions, directly contributing to a 30% increase in patient retention and 20% improvement in customer satisfaction.\r\n•\tServe as the first point of contact for inquiries, ensuring a seamless and positive experience through clear, compassionate communication.\r\nOnline Customer Service Representative\r\nFavemerit LLC – 2023 – 2024\r\n•\tFacilitated over 40 customer orders weekly through Instagram, WhatsApp, Facebook, and the company website, contributing to ₦1,050,000 in monthly revenue.\r\n•\tResponded to customer inquiries across multiple platforms, ensuring prompt and professional service delivery.\r\n•\tResolved customer complaints with a 95% resolution rate within 24 hours, boosting retention and satisfaction.\r\n•\tProcessed and fulfilled orders using WhatsApp and Shopify, ensuring timely and accurate dispatch.\r\n•\tConducted competitor benchmarking to support pricing strategy and performed regular price audits for consistency.\r\n•\tCollaborated with team leads to define and track weekly sales targets aligned with monthly revenue goals.\r\n"},"webhookUrl":"http://localhost:5678/webhook/start-interview","executionMode":"production"}}],"Webhook2":[{"json":{"headers":{"host":"n8n.dominixai.com","user-agent":"Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:141.0) Gecko/20100101 Firefox/141.0","content-length":"207","accept":"*/*","accept-encoding":"gzip, br","accept-language":"en-US,en;q=0.5","alt-used":"n8n.dominixai.com","cdn-loop":"cloudflare; loops=1","cf-connecting-ip":"102.90.96.19","cf-ipcountry":"NG","cf-ray":"964be5e42855d56f-LHR","cf-v