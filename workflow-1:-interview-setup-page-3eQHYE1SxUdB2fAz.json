{"createdAt":"2025-07-16T19:30:46.748Z","updatedAt":"2025-08-02T04:28:05.000Z","id":"3eQHYE1SxUdB2fAz","name":"Workflow 1: Interview Setup Page","active":true,"isArchived":false,"nodes":[{"parameters":{"content":"## Workflow1: Interview Setup =>\n**To show the user a form where they can enter the job role and paste their resume.** ","height":280,"width":720,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-380,-240],"typeVersion":1,"id":"72e6b920-93fd-4b4e-bcbc-991fbcbf9c0d","name":"Sticky Note"},{"parameters":{"path":"interview-setup","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-300,-140],"id":"c0b7fc90-fc70-4d1c-87b9-003e4f7b4ff7","name":"Webhook","webhookId":"771ecda2-ab7f-44e7-9b40-ff5d72e26d57"},{"parameters":{"respondWith":"text","responseBody":"={{ $json.html }}","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[140,-140],"id":"daad22fe-0c06-4d2d-a1e8-7a2677dedc12","name":"Respond to Webhook"},{"parameters":{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Mock Interview Setup</title>\n  <style>\n    body { font-family: sans-serif; background-color: #f4f4f9; color: #333; margin: 2em; }\n    .container { max-width: 800px; margin: 0 auto; background: #fff; padding: 2em; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }\n    h1 { color: #444; }\n    label { display: block; margin-top: 1em; margin-bottom: 0.5em; font-weight: bold; }\n    input, textarea { width: 100%; padding: 0.8em; border-radius: 4px; border: 1px solid #ccc; box-sizing: border-box; }\n    button { display: block; width: 100%; padding: 1em; margin-top: 2em; border: none; background-color: #007bff; color: #fff; font-size: 1em; border-radius: 4px; cursor: pointer; }\n    button:hover { background-color: #0056b3; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <h1>Mock Interview Setup</h1>\n    <p>Please provide the job role you're applying for and paste your resume below to begin your personalized interview.</p>\n    <form action=\"https://n8n.dominixai.com/webhook/start-interview\" method=\"POST\">\n      <label for=\"jobRole\">Job Role:</label>\n      <input type=\"text\" id=\"jobRole\" name=\"jobRole\" required>\n      <label for=\"userEmail\">Your Email:</label>\n      <input type=\"email\" id=\"userEmail\" name=\"userEmail\" required>\n      <label for=\"resumeText\">Paste Resume:</label>\n      <textarea id=\"resumeText\" name=\"resumeText\" rows=\"15\" required></textarea>\n      <button type=\"submit\">Start Interview (10 Points)</button>\n    </form>\n  </div>\n</body>\n</html>"},"type":"n8n-nodes-base.html","typeVersion":1.2,"position":[-80,-140],"id":"a9de9981-691f-4ede-b235-469c18322022","name":"HTML"}],"connections":{"Webhook":{"main":[[{"node":"HTML","type":"main","index":0}]]},"HTML":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":null,"pinData":{"Webhook":[{"json":{"headers":{"host":"localhost:5678","user-agent":"Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:141.0) Gecko/20100101 Firefox/141.0","accept":"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8","accept-language":"en-US,en;q=0.5","accept-encoding":"gzip, deflate, br, zstd","connection":"keep-alive","cookie":"rl_session=RudderEncrypt%3AU2FsdGVkX1%2FUhuwZosWHVa%2B%2B%2BUaP3tn4bT2WajRqT%2B9qWS4OtfGS23vrJls55tcMUQbzOS%2BaIEF%2Fz9wDyiHWI7IPwb5FNDDrwIFEKBiuvdmq4bFK6XMpX2vaKDTnYpMtcuTZ87B7dtkRBAp75UJ0FQ%3D%3D; rl_anonymous_id=RudderEncrypt%3AU2FsdGVkX19s3LmzZcvYe91XQZ6O49JM47M9Fd9GOHYRaXIkYOccKQnRI57JOULHYyxDkNioi3qI7lUlODTdOA%3D%3D; rl_page_init_referrer=RudderEncrypt%3AU2FsdGVkX1%2BlyL%2FORUXaQg557YXjanlVQPqQCkayMr0%3D; rl_page_init_referring_domain=RudderEncrypt%3AU2FsdGVkX19gaar0uhgeCR1AugZzEmLEtVZnY3Yhe8I%3D; sb-kijkmzqikcvnsetllvij-auth-token=base6