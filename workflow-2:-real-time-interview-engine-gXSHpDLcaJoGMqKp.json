{"createdAt":"2025-07-16T19:23:06.854Z","updatedAt":"2025-07-31T21:25:23.000Z","id":"gXSHpDLcaJoGMqKp","name":"Workflow 2: Real-Time Interview Engine","active":true,"isArchived":false,"nodes":[{"parameters":{"method":"POST","url":"https://api.openai.com/v1/realtime/sessions","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"Bearer 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"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify({\n  instructions: $('Code').item.json.instructions,\n  model: \"gpt-4o-realtime-preview-2024-12-17\",\n  modalities: [\"audio\", \"text\"],\n  voice: \"alloy\",\n  input_audio_transcription: {\n    model: \"whisper-1\"\n  }\n}) }}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[320,-80],"id":"84dbbc37-b1ad-45d3-962d-ff64f7a152f9","name":"HTTP Request"},{"parameters":{"httpMethod":"POST","path":"start-interview","responseMode":"responseNode","options":{"allowedOrigins":"*"}},"type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-100,-80],"id":"d7881b79-6d82-4dc7-b95a-d16447f925ba","name":"Webhook","webhookId":"32b73c7b-424e-4ed7-aa29-25ffbb46f1ee"},{"parameters":{"html":"<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>NanoAI RT</title>\n  \n  <style>\n    .container {\n      background-color: #ffffff;\n      text-align: left;\n      padding: 16px;\n      border-radius: 8px;\n    }\n    .msg {\n      padding: 5px; \n      background-color: #eee;\n    }\n    .msgUsr {\n      padding: 5px; \n      background-color: #e4eefd;\n    }\n    .curMsg {\n      padding: 5px; \n      background-color: #e6ffd9;\n    }\n    h1 {\n      margin: 5px;\n      font-size: 20px;\n    }\n  </style>\n</head>\n<body>\n    \n  <h1>Let's talk! You go first...</h1>\n  <div id=\"timer\" style=\"font-size: 1.2em; font-weight: bold; color: #d9534f; margin-bottom: 1em;\"></div>\n  <div class=\"container\">\n    <div class=\"messages\"></div>\n    <div class=\"curMsg\"></div>    \n    <button id=\"finishButton\">Finish Interview & Get Report</button>\n  </div>\n  \n<script>\n  const userEmail = \"{{ $('Webhook').item.json.body.userEmail }}\";\n  document.addEventListener('DOMContentLoaded', (event) => {\n    const finishButton = document.getElementById('finishButton');\n    if (finishButton) {\n      finishButton.addEventListener('click', async () => {\n        const messagesDiv = document.querySelector('.messages');\n        const transcript = messagesDiv.innerText;\n\n        finishButton.disabled = true;\n        finishButton.innerText = \"Generating Report...\";\n\n        const response = await fetch('https://n8n.dominixai.com/webhook/generate-report', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          // FIX: Removed the extra comma at the end of this line\n          body: JSON.stringify({ transcript: transcript, email: userEmail })\n        });\n\n        const reportHtml = await response.text();\n        document.body.innerHTML = reportHtml;\n      });\n    }\n  });\n\n  function startTimer(duration, display) {\n    let timer = duration * 60, minutes, seconds;\n\n    const interval = setInterval(function () {\n      minutes = parseInt(timer / 60, 10);\n      seconds = parseInt(timer % 60, 10);\n\n      minutes = minutes < 10 ? \"0\" + minutes : minutes;\n      seconds = seconds < 10 ? \"0\" + seconds : seconds;\n\n      display.textContent = \"Time Remaining: \" + minutes + \":\" + seconds;\n\n      if (--timer < 0) {\n        clearInterval(interval);\n        display.textContent = \"Time's up! Generating your report...\";\n        document.getElementById('finishButton').click();\n      }\n    }, 1000);\n  }\n  \n  function handleResponse(e) {\n    var obj = JSON.parse(e.data);\n    \n    if (obj.type == 'response.audio_transcript.done') {\n      document.querySelector('.curMsg').innerHTML = \"\";\n      document.querySelector('.messages').innerHTML += \"<div class='msg'>AI: \" + obj.transcript + \"</div><br/>\";\n    }\n\n    if (obj.type == 'conversation.item.input_audio_transcription.completed') {\n      document.querySelector('.curMsg').innerHTML = \"\";\n      document.querySelector('.messages').innerHTML += \"<div class='msgUsr'>User: \" + obj.transcript + \"</div><br/>\";\n    }\n    \n    if (obj.type == 'response.audio_transcript.delta') {\n      document.querySelector('.curMsg').innerHTML += obj.delta;\n    }\n  \n    if (obj.type == 'conversation.item.input_audio_transcription.delta') {\n      document.querySelector('.curMsg').innerHTML += obj.delta;\n    }\n  }\n\n  async function init() {\n    // Starts the timer as soon as the interview begins\n    const interviewDuration = 15; \n    const display = document.querySelector('#timer');\n    startTimer(interviewDuration, display);\n\n    // Get an ephemeral key from your server\n    const EPHEMERAL_KEY = \"{{ $json.ephemeralKey }}\";\n    // FIX: Removed the duplicate declaration of EPHEMERAL_KEY\n\n    // Create a peer connection\n    const pc = new RTCPeerConnection();\n\n    // Set up to play remote audio from the model\n    const audioEl = document.createElement(\"audio\");\n    audioEl.autoplay = true;\n    pc.ontrack = e => audioEl.srcObject = e.streams[0];\n\n    // Add local audio track for microphone input in the browser\n    const ms = await navigator.mediaDevices.getUserMedia({\n      audio: true\n    });\n    pc.addTrack(ms.getTracks()[0]);\n\n    // Set up data channel for sending and receiving events\n    const dc = pc.createDataChannel(\"oai-events\");\n    dc.addEventListener(\"message\", (e) => {\n      // Realtime server events appear here!\n      console.log(e);\n      handleResponse(e);\n    });\n\n    // Start the session using the Session Description Protocol (SDP)\n    const offer = await pc.createOffer();\n    await pc.setLocalDescription(offer);\n\n    const baseUrl = \"https://api.openai.com/v1/realtime\";\n    const model = \"gpt-4o-realtime-preview-2024-12-17\";\n    const sdpResponse = await fetch(`${baseUrl}?model=${model}`, {\n      method: \"POST\",\n      body: offer.sdp,\n      headers: {\n        Authorization: `Bearer ${EPHEMERAL_KEY}`,\n        \"Content-Type\": \"application/sdp\"\n      },\n    });\n\n    const answer = {\n      type: \"answer\",\n      sdp: await sdpResponse.text(),\n    };\n    await pc.setRemoteDescription(answer);\n  }\n\n  // This starts the whole process\n  init();\n</script>\n</body>\n</html>"},"type":"n8n-nodes-base.html","typeVersion":1.2,"position":[760,-80],"id":"d57b7809-e053-403c-89b4-5c707114dedc","name":"HTML"},{"parameters":{"respondWith":"text","responseBody":"={{ $json.html }}","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[980,-80],"id":"a8fb2966-1da6-4302-912a-c890366b0416","name":"Respond to Webhook"},{"parameters":{"content":"## Workflow2: Time Interview Engine=>\n**To receive the form data from Workflow 1, create a custom AI session, and serve the real-time chat page..** ","height":300,"width":1300,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-120,-180],"typeVersion":1,"id":"a6d3f4a4-3c43-4d0e-8a77-317d8d876299","name":"Sticky Note"},{"parameters":{"jsCode":"// The 'items' variable contains all incoming data.\n// We will loop through each item, modify it, and return it.\nfor (let item of items) {\n  // Get the body from the incoming JSON data of the current item\n  let body = item.json.body;\n\n  // Construct the instructions string\n  let instructions = \"You are a professional hiring manager. Your first task is to greet the user and confirm the role they are interviewing for by saying: 'Hello, thanks for coming in. Just to confirm, you're interviewing for the role of \" + body.jobRole + \", is that correct?'. Wait for their confirmation before proceeding with the interview. The entire interview must last for a maximum of 15 minutes. Use the candidate's resume, provided below, to ask specific and relevant questions. A minute or two before the time is up, you must gracefully conclude the conversation.\\\\n\\\\n---RESUME---\\\\n\" + body.resumeText + \"\\\\n---END RESUME---\";\n\n  // Add the new 'instructions' field to the JSON data of the current item\n  item.json.instructions = instructions;\n}\n\n// Return all the modified items to be passed to the next node\nreturn items;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[100,-80],"id":"ab326213-fbf1-4794-9eb2-15db9b62ba63","name":"Code"},{"parameters":{"assignments":{"assignments":[{"id":"0d0fdf66-cc36-4ba0-8bfd-c560bcb1060d","name":"ephemeralKey","value":"={{ $json.client_secret.value }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[540,-80],"id":"78040780-bb40-44ee-a63f-df7dcd269c92","name":"Edit Fields"}],"connections":{"HTTP Request":{"main":[[{"node":"Edit Fields","type":"main","index":0}]]},"Webhook":{"main":[[{"node":"Code","type":"main","index":0}]]},"HTML":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]},"Code":{"main":[[{"node":"HTTP Request","type":"main","index":0}]]},"Edit Fields":{"main":[[{"node":"HTML","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":null,"pinData":{"Webhook":[{"json":{"headers":{"host":"localhost:5678","user-agent":"Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:141.0) Gecko/20100101 Firefox/141.0","accept":"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8","accept-language":"en-US,en;q=0.5","accept-encoding":"gzip, deflate, br, zstd","content-type":"application/x-www-form-urlencoded","content-length":"3403","origin":"http://localhost:5678","connection":"keep-alive","referer":"http://localhost:5678/webhook/interview-setup","