{"updatedAt":"2025-11-11T01:38:01.000Z","createdAt":"2025-11-11T01:38:01.602Z","id":"4n1mxFUSFAgegX3m","name":"VAPI Voice Agent Integration","active":false,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"vapi-call-start","responseMode":"lastNode","options":{}},"id":"8770d5aa-4d25-493d-b3a9-a73ba3cc50c2","name":"Webhook - VAPI Call Start","type":"n8n-nodes-base.webhook","typeVersion":1,"position":[-912,192],"webhookId":"e2d13642-87b7-4c56-a16c-9466cff5f389"},{"parameters":{"jsCode":"// Extract call data from VAPI webhook\nconst callData = $input.item.json;\n\nreturn {\n  json: {\n    callId: callData.call.id,\n    phoneNumber: callData.call.customer.number,\n    callType: callData.message.type,\n    timestamp: callData.message.timestamp\n  }\n};"},"id":"bba8adb0-77bd-4de1-a88a-f9649dd1ddf5","name":"Code - Extract Call Data","type":"n8n-nodes-base.code","typeVersion":2,"position":[-720,192]},{"parameters":{"operation":"search","base":"={{ $env.AIRTABLE_BASE_ID }}","table":"Leads","filterByFormula":"={Phone} = '{{ $json.phoneNumber }}'","options":{}},"id":"1172c568-0237-4ac9-96b8-8d2d583c11ce","name":"Airtable - Find Lead by Phone","type":"n8n-nodes-base.airtable","typeVersion":2,"position":[-512,192]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.id }}","rightValue":"","operator":{"type":"string","operation":"exists","singleValue":true}}],"combinator":"and"},"options":{}},"id":"fdeef4af-4920-4497-a3a3-e210e5960a52","name":"IF - Lead Found","type":"n8n-nodes-base.if","typeVersion":2,"position":[-320,192]},{"parameters":{"jsCode":"// Build context injection message for returning caller\nconst lead = $input.item.json.fields;\n\nconst contextMessage = `Oh hey, I noticed you've reached out before. Just to confirm:\n- Your goal is ${lead.Goal || 'not specified'}\n- You want to reach ${lead['Dream Outcome'] || 'your desired outcome'}\n- Your main blocker is ${lead.Blocker || 'not specified'}\n\nIs that still correct?`;\n\nreturn {\n  json: {\n    callId: $('Code - Extract Call Data').item.json.callId,\n    contextMessage,\n    leadEmail: lead.Email,\n    leadName: lead['First Name']\n  }\n};"},"id":"0284d7d0-016e-46f9-bda7-e6fd6c2903d2","name":"Code - Build Context Message","type":"n8n-nodes-base.code","typeVersion":2,"position":[-112,80]},{"parameters":{"method":"POST","url":"https://api.vapi.ai/call/{{ $json.callId }}/inject","authentication":"predefinedCredentialType","nodeCredentialType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"{{ $json.contextMessage }}\"\n    }\n  ]\n}","options":{}},"id":"2959918b-61d7-463c-8f43-f5b02ea95bb3","name":"HTTP - VAPI Inject Context","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[96,80]},{"parameters":{"respondWith":"json","responseBody":"={{ { \"success\": true, \"leadFound\": true } }}","options":{}},"id":"2b284db2-9b0e-4a81-b5a7-3486d85ab0e9","name":"Respond - Success","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[288,80]},{"parameters":{"respondWith":"json","responseBody":"={{ { \"success\": true, \"leadFound\": false } }}","options":{}},"id":"4920af9d-3b2c-4978-9f54-16beef831c7f","name":"Respond - No Lead","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[-112,288]},{"parameters":{"httpMethod":"POST","path":"vapi-booking-request","responseMode":"lastNode","options":{}},"id":"fd81251a-5861-4ca3-9266-b942c5fe515b","name":"Webhook - VAPI Booking Request","type":"n8n-nodes-base.webhook","typeVersion":1,"position":[-912,480],"webhookId":"85e56813-bebc-4b9b-8247-5cca2e28d30a"},{"parameters":{"jsCode":"// Extract booking request data\nconst data = $input.item.json;\n\nreturn {\n  json: {\n    callId: data.call.id,\n    phoneNumber: data.call.customer.number,\n    productInterest: data.message.toolCalls?.[0]?.function?.arguments?.product || 'Content Engine Database'\n  }\n};"},"id":"18af136a-652c-4ff1-b87a-5831074a8e57","name":"Code - Extract Booking Request","type":"n8n-nodes-base.code","typeVersion":2,"position":[-720,480]},{"parameters":{"operation":"search","base":"={{ $env.AIRTABLE_BASE_ID }}","table":"Leads","filterByFormula":"={Phone} = '{{ $json.phoneNumber }}'","options":{}},"id":"e960ab3a-5ff5-4814-9e0b-7801afe8e0de","name":"Airtable - Get Lead for Booking","type":"n8n-nodes-base.airtable","typeVersion":2,"position":[-512,480]},{"parameters":{"base":"={{ $env.AIRTABLE_BASE_ID }}","table":"Products","id":"={{ $json.fields.Product[0] }}","options":{}},"id":"ebfa7f5c-84cb-4f78-9547-41a0ad42fab1","name":"Airtable - Get Product Cal Link","type":"n8n-nodes-base.airtable","typeVersion":2,"position":[-320,480]},{"parameters":{"jsCode":"// Build Cal.com booking link with prefilled data\nconst lead = $('Airtable - Get Lead for Booking').item.json.fields;\nconst product = $input.item.json.fields;\nconst bookingData = $('Code - Extract Booking Request').item.json;\n\nconst calLink = product['Sales Call Link'];\nconst prefillParams = new URLSearchParams({\n  name: lead['First Name'],\n  email: lead.Email,\n  notes: `Goal: ${lead.Goal}\\nBlocker: ${lead.Blocker}\\nDream Outcome: ${lead['Dream Outcome']}`\n});\n\nconst fullBookingLink = `${calLink}?${prefillParams.toString()}`;\n\nreturn {\n  json: {\n    bookingLink: fullBookingLink,\n    phoneNumber: bookingData.phoneNumber,\n    callId: bookingData.callId,\n    leadName: lead['First Name']\n  }\n};"},"id":"c4aca7e7-1ae9-4667-8acc-69b741f5d4dc","name":"Code - Build Booking Link","type":"n8n-nodes-base.code","typeVersion":2,"position":[-112,480]},{"parameters":{"message":"Hi {{ $json.leadName }}! Here's your booking link: {{ $json.bookingLink }}\\n\\nPlease select your preferred time and let me know when you're done. I'll wait here on the call.","options":{}},"id":"a82042f6-d223-406b-b858-0d6dc7b43e9e","name":"Twilio - Send Booking Link","type":"n8n-nodes-base.twilio","typeVersion":1,"position":[96,480]},{"parameters":{"respondWith":"json","responseBody":"={{ { \"success\": true, \"message\": \"Booking link sent to phone\", \"action\": \"waitForBooking\" } }}","options":{}},"id":"d6e1d29c-f0d2-42a0-9cd2-17eb379e94a7","name":"Respond - Booking Link Sent","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[288,480]},{"parameters":{"httpMethod":"POST","path":"cal-booking-confirmed","responseMode":"responseNode","options":{}},"id":"439d4cc9-ec93-4d6e-8f0f-a22c2e5084ad","name":"Webhook - Cal.com Booking Confirmed","type":"n8n-nodes-base.webhook","typeVersion":1,"position":[-912,784],"webhookId":"956bc6d9-b6a8-433f-9bd3-cfdd4fab9859"},{"parameters":{"jsCode":"// Extract booking confirmation data from Cal.com\nconst booking = $input.item.json;\n\nreturn {\n  json: {\n    bookingId: booking.uid,\n    attendeeEmail: booking.attendees[0].email,\n    attendeeName: booking.attendees[0].name,\n    startTime: booking.startTime,\n    endTime: booking.endTime,\n    meetingLink: booking.location || booking.metadata?.conferenceData?.hangoutLink\n  }\n};"},"id":"4c3d1cdd-eb60-4e72-bd29-fc1b586d1c09","name":"Code - Extract Booking Data","type":"n8n-nodes-base.code","typeVersion":2,"position":[-720,784]},{"parameters":{"operation":"search","base":"={{ $env.AIRTABLE_BASE_ID }}","table":"Leads","filterByFormula":"={Email} = '{{ $json.attendeeEmail }}'","options":{}},"id":"7eb2920a-02fc-45f2-b175-89b46ba3de45","name":"Airtable - Find Lead by Email","type":"n8n-nodes-base.airtable","typeVersion":2,"position":[-512,784]},{"parameters":{"jsCode":"// Find active VAPI call for this lead\nconst lead = $input.item.json.fields;\nconst bookingData = $('Code - Extract Booking Data').item.json;\n\n// Format booking time\nconst bookingTime = new Date(bookingData.startTime);\nconst dayOfWeek = bookingTime.toLocaleDateString('en-US', { weekday: 'long' });\nconst time = bookingTime.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });\n\nconst confirmationMessage = `Great news! Your call is confirmed for ${dayOfWeek} at ${time}. You're all set to go.`;\n\nreturn {\n  json: {\n    confirmationMessage,\n    phoneNumber: lead.Phone,\n    bookingTime: `${dayOfWeek} at ${time}`\n  }\n};"},"id":"7826cf17-97e4-4228-b6d0-934a69d5f4ab","name":"Code - Build Confirmation Message","type":"n8n-nodes-base.code","typeVersion":2,"position":[-320,784]},{"parameters":{"method":"POST","url":"https://api.vapi.ai/call/active","authentication":"predefinedCredentialType","nodeCredentialType":"httpHeaderAuth","sendQuery":true,"queryParameters":{"parameters":[{"name":"phoneNumber","value":"={{ $json.phoneNumber }}"}]},"options":{}},"id":"a825b23d-1b79-495e-ac0f-289c635cade7","name":"HTTP - Get Active VAPI Call","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-112,784]},{"parameters":{"method":"POST","url":"https://api.vapi.ai/call/={{ $json.id }}/inject","authentication":"predefinedCredentialType","nodeCredentialType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"{{ $('Code - Build Confirmation Message').item.json.confirmationMessage }}\"\n    }\n  ]\n}","options":{}},"id":"e6c8043f-d57e-496e-9021-93b31940a121","name":"HTTP - Inject Booking Confirmation","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[96,784]},{"parameters":{"respondWith":"json","responseBody":"={{ { \"success\": true } }}","options":{}},"id":"d7f94474-232e-46ed-a717-bddd34885783","name":"Respond - Confirmation Sent","type":"n8n-nodes-base.respondToWebhook","typeVersion":1,"position":[288,784]}],"connections":{"Webhook - VAPI Call Start":{"main":[[{"node":"Code - Extract Call Data","type":"main","index":0}]]},"Code - Extract Call Data":{"main":[[{"node":"Airtable - Find Lead by Phone","type":"main","index":0}]]},"Airtable - Find Lead by Phone":{"main":[[{"node":"IF - Lead Found","type":"main",