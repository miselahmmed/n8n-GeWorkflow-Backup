{"createdAt":"2025-08-11T16:24:55.634Z","updatedAt":"2025-08-29T07:56:09.000Z","id":"o3eaTriREVItpudz","name":"Adzuna (US)/JobMonkey Job Search Automation","active":true,"isArchived":false,"nodes":[{"parameters":{"operation":"pdf","binaryPropertyName":"data0","options":{}},"type":"n8n-nodes-base.extractFromFile","typeVersion":1,"position":[-1168,2736],"id":"262c0238-ad59-41a4-a55e-3d48baeadd7c","name":"Extract from File"},{"parameters":{"respondWith":"text","responseBody":"{\n  \"status\": \"success\",\n  \"message\": \"Request received. Job search and other processes are now ongoing in the background. Depending on the number of jobs being processed, this may take up to 5 or more minutes.The results will be sent to your mailbox. Thank you- The JobMonky Team\"\n}","options":{"responseHeaders":{"entries":[{"name":"Content-Type","value":"application/json"}]}}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[-1344,2736],"id":"0fefc2c1-25f0-4920-bbce-2e664823cf6f","name":"Respond to Webhook"},{"parameters":{"content":"## Step 1: Get Request from User=>\n\n","height":1120,"width":820,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-1616,2224],"typeVersion":1,"id":"87c74c28-2025-4c89-b78f-aa725faa77a4","name":"Sticky Note"},{"parameters":{"assignments":{"assignments":[{"id":"99d327d4-7bed-4b76-9150-75247e4eaf0f","name":"job_title","value":"={{ $('Webhook').item.json.body.jobSearchKeyword }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-960,2736],"id":"c0d363d9-cf06-422a-b1c1-e842dc2245e9","name":"Set Job Title"},{"parameters":{"content":"# Need Help?\n\n# Reach me: https://www.linkedin.com/in/gerald-akhidenor-1ab1a45/ #\n\n# Work with me: https://dominixai.com/ #\n\n# My website: https://jobmonkey.dev #\n\n# My email: denorgerald@gmail.com #\n","height":480,"width":1000,"color":4},"type":"n8n-nodes-base.stickyNote","position":[1088,1360],"typeVersion":1,"id":"c8095e4f-76c2-465f-a73d-916e45d2d8aa","name":"Sticky Note1"},{"parameters":{"httpMethod":"POST","path":"adzuna","responseMode":"responseNode","options":{"binaryPropertyName":"data"}},"type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-1536,2736],"id":"f46d2600-2b50-460a-b71a-6808c8c4da4d","name":"Webhook","webhookId":"b50e74e2-32fa-4b27-8a52-a94889e0d06b"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"bd5a9af0-b569-4a75-9744-20699a5021d0","leftValue":"={{ Number(JSON.parse($json.output.replace(/```(json)?\\n|```/g, '')).score) }}","rightValue":3,"operator":{"type":"number","operation":"gte"}}],"combinator":"and"},"looseTypeValidation":true,"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[2224,2848],"id":"7d0060de-9cff-4cd7-ba02-54d438d36635","name":"📈 IF Score ≥ 3","alwaysOutputData":true},{"parameters":{"amount":10},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[2528,2832],"id":"7c7cec97-2323-4535-afa6-49377e8a298c","name":"Wait1","webhookId":"6dcb9ddf-8e96-4b49-aa55-aa46695848ae"},{"parameters":{"model":{"__rl":true,"value":"o3","mode":"list","cachedResultName":"o3"},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.2,"position":[2864,3136],"id":"353cb0ef-315b-430e-85b9-0186677d548c","name":"OpenAI Chat Model","credentials":{"openAiApi":{"id":"ySmjTBAwyTsi9kbr","name":"OpenAi account 1"}}},{"parameters":{"promptType":"define","text":"=As an expert hiring manager, analyze the Job Description and Candidate Resume.\n\n### JOB DESCRIPTION\n{{ $json.job_description }}\n\n### CANDIDATE RESUME\n{{ $('Extract from File').item.json.text }}\n\n### INSTRUCTIONS\nReturn a single JSON object with two keys: \"skills\" and \"score\".\n- \"skills\": An array of the top skills from the job description.\n- \"score\": A number from 1 to 5 indicating how well the resume matches the job skills.\n\nExample Output:\n{\n  \"skills\": [\"Project Management\", \"Agile Methodologies\", \"JIRA\"],\n  \"score\": 4\n}","options":{}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":2,"position":[1888,2848],"id":"f1f9897d-adcf-4262-92eb-86d1f2d8f523","name":"Score Resume Match to Extracted Skills from Job Description","executeOnce":false},{"parameters":{"promptType":"define","text":"=You are an expert career writer. Based on the Job Description and the Candidate's Resume, perform the following two tasks.\n\n### ROLE DETAILS\n- Job Title: {{ $('Loop Over Items').item.json.job_title }}\n- Company: {{ $('Loop Over Items').item.json.company_name }}\n\n### CANDIDATE RESUME\n{{ $('Extract from File').item.json.text }}\n\n### INSTRUCTIONS\nFirst, rewrite the resume as a clean HTML fragment optimized for this job.\nSecond, write a persuasive, ATS-friendly cover letter as an HTML fragment for this job.\n\nStructure your entire response with the following clear headings so I can parse it easily. Do not include any other text or explanation.\n\n### REWRITTEN RESUME ###\n[The full rewritten resume HTML goes here]\n\n### COVER LETTER ###\n[The full cover letter HTML goes here]","messages":{"messageValues":[{"message":"You are an expert and helpful career writer"}]},"batching":{}},"type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.7,"position":[2736,2832],"id":"a056ea0d-8aa8-48b0-b253-03b06052b99a","name":"🔥Write Cover Letter & Rewrite Resume1"},{"parameters":{"jsCode":"// This code goes inside the \"Split cover letter from resume\" node.\n// It cleans and correctly parses the LLM output.\n\n// Get the full output from the LLM node\nconst llmOutput = $('🔥Write Cover Letter & Rewrite Resume1').item.json.text;\n\n// Clean up the output by removing the markdown code blocks and extra whitespace\nconst cleanedOutput = llmOutput.replace(/```(html)?\\n|```/g, '').trim();\n\n// Split the output into two parts based on the headings\nconst parts = cleanedOutput.split('### COVER LETTER ###');\n\n// Extract the resume and remove the resume heading\nconst resumeHtml = parts[0].replace('### REWRITTEN RESUME ###', '').trim();\n\n// Extract the cover letter and remove any extra whitespace\nconst coverLetterHtml = parts[1].trim();\n\n// Return the job data with the new, correctly separated properties\nreturn [{\n  json: {\n    job_title: $('Loop Over Items').item.json.job_title || \"Title Not Found\",\n    company_name: $('Loop Over Items').item.json.company_name || \"Company Not Found\",\n    job_url: $('Loop Over Items').item.json.job_url || \"#\",\n    job_description: $('Loop Over Items').item.json.job_description,\n    email: $('Webhook').item.json.body.email,\n    cover_letter: coverLetterHtml,\n    tailored_resume: resumeHtml\n  }\n}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[3072,2832],"id":"ee1775ae-7d1b-4f99-b21e-be4b7b535bce","name":"Split cover letter from resume"},{"parameters":{"jsCode":"// Debug version - collect all jobs after loop completes\nconsole.log(\"=== COLLECTING ALL JOBS ===\");\n\ntry {\n  // Get all processed jobs from \"Prepare Final Job\" node\n  const jobResults = $items(\"Prepare Final Job\");\n  console.log(\"Total items from Prepare Final Job:\", jobResults.length);\n  \n  const allJobs = [];\n  jobResults.forEach((item, index) => {\n    if (item && item.json) {\n      console.log(`Job ${index + 1}:`, item.json.job_title);\n      allJobs.push({\n        job_title: item.json.job_title || \"Title Not Found\",\n        company_name: item.json.company_name || \"Company Not Found\",\n        job_url: item.json.job_url || \"#\",\n        job_description: item.json.job_description || \"No description\",\n        cover_letter: item.json.cover_letter || \"Cover letter not available\",\n        tailored_resume: item.json.tailored_resume || \"Resume not available\",\n        email: item.json.email || \"\"\n      });\n    }\n  });\n  \n  console.log(\"FINAL RESULT: Collected\", allJobs.length, \"jobs\");\n  \n  return [{\n    json: {\n      jobs: allJobs,\n      totalProcessed: allJobs.length\n    }\n  }];\n  \n} catch (error) {\n  console.log(\"Collection error:\", error.message);\n  return [{\n    json: {\n      jobs: [],\n      totalProcessed: 0,\n      error: error.message\n    }\n  }];\n}"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2800,2592],"id":"982692d1-2d9e-415a-9d8b-547f7d41d36d","name":"Collect jobs into one array"},{"parameters":{"assignments":{"assignments":[{"id":"b8e5d118-e34e-4e15-a3b1-27c313438720","name":"collection_ready","value":true,"type":"boolean"},{"id":"473aa8f5-36ce-4e4b-8e3c-979b519c7f3a","name":"total_jobs_processed","value":"={{ $('Loop Over Items').item.json.batchSize || 0 }}","type":"number"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[2064,2592],"id":"68a27134-d5d5-42a9-a2f8-5c8858f67003","name":"Gather jobs before sending"},{"parameters":{"content":"## Step 3: Analyze Job, Match Resume to Job and Write a Customized Resume for the New Job=>","height":1140,"width":3480,"color":4},"type":"n8n-nodes-base.stickyNote","position":[288,2224],"typeVersion":1,"id":"8d488306-5bfa-4ad6-b81e-1a1ddab526cf","name":"Sticky Note5"},{"parameters":{"resource":"Datasets","datasetId":"={{ $json.defaultDatasetId }}","offset":{}},"type":"@apify/n8n-nodes-apify.apify","typeVersion":1,"position":[-256,3104],"id":"c85b9e4e-dc41-48a0-aee1-7bc35aae39d5","name":"Apify: Get Glassdoor Results1","credentials":{"apifyApi":{"id":"2xcqVAa5VnPvmUtO","name":"Apify API denorgerald"}},"disabled":true,"onError":"continueRegularOutput"},{"parameters":{"content":"## Step 4: Feedback to User=>\n","height":1140,"width":1460,"color":4},"type":"n8n-nodes-base.stickyNote","position":[3792,2224],"typeVersion":1,"id":"c8520869-b60e-4fc8-8885-adff41f25dc8","name":"Sticky Note6"},{"parameters":{"content":"## Step 2: Retrieve Job Data from Various job Boards Via API=>\n","height":1120,"width":1040,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-768,2224],"typeVersion":1,"id":"6e50a254-903c-4c7f-9307-5f1dca538693","name":"Sticky Note3"},{"parameters":{"options":{}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[1440,2672],"id":"c6e9e57f-3c1e-4489-901e-860404eb25ba","name":"Loop Over Items"},{"parameters":{"jsCode":"// Set the maximum number of jobs you want to process.\nconst maxJobs = 10;\n\n// This line takes the full list of jobs and returns only the first 15.\nreturn items.slice(0, maxJobs);"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1232,2672],"id":"29dd4364-b714-43c4-8276-0b7d12149fa7","name":"Job Feed Limiter"},{"parameters":{"jsCode":"const seen = new Set();\n\nfunction normalizeText(text) {\n  return text.toLowerCase()\n    .trim()\n    .replace(/[^\\w\\s]/g, '') // Remove special characters\n    .replace(/\\s+/g, ' ');   // Normalize whitespace\n}\n\nreturn items.filter(item => {\n  const job = item.json;\n  \n  // Extract with fallbacks and normalize\n  const title = normalizeText(\n    job.title || job.jobTitle || job.job_title || job.name || \n    job.position || job.positionTitle || job.role || job.jobName ||\n    job.job?.title || ''\n  );\n  \n  const company = normalizeText(\n    job.company || job.companyName || job.company_name || \n    job.employer || job.organization || job.job?.company || ''\n  );\n  \n  const description = normalizeText(\n    (job.description || job.jobDescription || job.job_description || \n     job.summary || job.details || job.job?.description || '')\n    .substring(0, 100)\n  );\n  \n  // Skip if we don't have enough data to create a meaningful key\n  if (!title && !company) {\n    return true; // Keep items we can't properly identify\n  }\n  \n  const key = `${title}-${company}-${description}`;\n  \n  if (seen.has(key)) {\n    return false;\n  }\n  seen.add(key);\n  return true;\n});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1008,2672],"id":"040d977c-d6bf-43f1-9b8e-fe24359837a9","name":"Filter Duplicates"},{"parameters":{"conditions":{"options":{"caseSensitive":