Name":"status","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"cover_letter","displayName":"cover_letter","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"row_number","displayName":"row_number","required":false,"defaultMatch":false,"display":true,"type":"number","canBeUsedToMatch":true,"readOnly":true,"removed":true}],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.6,"position":[3536,2832],"id":"77d0cfc8-af50-4622-87b0-29abf6078381","name":"Upate sheets","alwaysOutputData":true,"credentials":{"googleSheetsOAuth2Api":{"id":"M9hAVeUu4zs26iIe","name":"Google Sheets account"}}},{"parameters":{},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[3792,2912],"id":"8fd406db-e313-4cf9-9be3-c73bb79e832c","name":"Wait","webhookId":"cbaa0df5-7b13-442b-8bff-141a51ec800a"},{"parameters":{"jsCode":"// Safer approach to access data\nconst inputData = $input.all();\nconsole.log(\"Input data received:\", inputData.length, \"items\");\n\nif (inputData.length === 0) {\n  return [{\n    json: {\n      status: 'failure',\n      reason: 'No data received from collection node'\n    }\n  }];\n}\n\nconst collectedData = inputData[0].json;\nconsole.log(\"Collected data structure:\", Object.keys(collectedData));\n\nconst successfulJobs = collectedData.jobs || [];\nconsole.log(\"Jobs found:\", successfulJobs.length);\n\n// Get webhook data using items() instead of accessing directly\nconst webhookItems = $items(\"Webhook\");\nconst webhookData = webhookItems[0].json;\nconst userEmail = webhookData.body.email;\nconst userName = webhookData.body.name;\nconst transactionId = webhookData.body.transactionId;\nconst submissionId = webhookData.body.submissionId;\n\n// Rest of your email building logic stays the same...\nif (successfulJobs.length === 0) {\n  return [{\n    json: {\n      status: 'failure',\n      reason: 'No matching jobs were found to process after filtering.',\n      userEmail,\n      userName,\n      transactionId,\n      submissionId\n    }\n  }];\n}\n\n// Build email HTML (keeping your existing code)\nlet emailHtml = `\n<html>\n  <body style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333;\">\n    <p>Hi ${userName},</p>\n    <p>Your JobMonkey request is complete! Here are the tailored resume(s) and cover letter(s) for the ${successfulJobs.length} job(s) that was/were successfully processed:</p>\n`;\n\nlet jobCounter = 1;\nfor (const jobData of successfulJobs) {\n  const jobTitle = jobData.job_title || 'Title Not Available';\n  const companyName = jobData.company_name || jobData.company || 'Company Not Available';\n  const jobUrl = jobData.job_url || '#';\n  const coverLetter = jobData.cover_letter || 'Cover letter not available';\n  const tailoredResume = jobData.tailored_resume || 'Resume not available';\n\n  emailHtml += `\n    <hr style=\"margin: 30px 0; border: 1px solid #ccc;\">\n    <h2>Job #${jobCounter}: ${jobTitle} at ${companyName}</h2>\n    <p><strong>Job URL:</strong> <a href=\"${jobUrl}\">${jobUrl}</a></p>\n    \n    <h3>Your Cover Letter:</h3>\n    <div style=\"background: #f9f9f9; padding: 15px; border: 1px solid #eee; border-radius: 8px; margin-bottom: 15px;\">\n      ${coverLetter}\n    </div>\n    \n    <h3>Your Tailored Resume:</h3>\n    <div style=\"background: #f9f9f9; padding: 15px; border: 1px solid #eee; border-radius: 8px;\">\n      ${tailoredResume}\n    </div>\n  `;\n  jobCounter++;\n}\n\nemailHtml += `\n    <hr style=\"margin-top: 30px;\">\n    <p>Good luck with your applications!</p>\n    <p>The JobMonkey Team</p>\n  </body>\n</html>\n`;\n\nreturn [{\n  json: {\n    finalEmailBody: emailHtml,\n    userEmail,\n    userName,\n    status: 'success',\n    submissionId\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[4080,2592],"id":"e9c59324-ee46-48b5-9e99-14c8d6f32d3c","name":"Aggregate Results"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"73a9dee4-4d64-4225-8698-36b27309a6fc","leftValue":"={{ $json.status === 'success' }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[4272,2752],"id":"7fb2dabc-e689-4ee7-973e-e01471ed01c5","name":"Check Status"},{"parameters":{"method":"POST","url":"https://jobmonkey.dev/wp-json/jobmonkey/v1/update_submission","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"submissionId\": \"{{ $json.submissionId }}\",\n  \"status\": \"Failed\"\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[4640,2800],"id":"b37f7c9f-19eb-4c64-b3e9-8cf16bb35184","name":"Update Status to Failed","credentials":{"httpHeaderAuth":{"id":"N1j0c0NPa0OEHIRv","name":"WP JobMonkey API"}}},{"parameters":{"method":"POST","url":"https://jobmonkey.dev/wp-json/jobmonkey/v1/update_submission","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"submissionId\": \"{{ $json.submissionId }}\",\n  \"status\": \"Completed\"\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[4624,2496],"id":"48d5f11e-0b6b-4737-8981-576155019464","name":"Update Status to Completed","credentials":{"httpHeaderAuth":{"id":"N1j0c0NPa0OEHIRv","name":"WP JobMonkey API"}},"disabled":true},{"parameters":{"fromEmail":"=  Gerald from JobMonkey <gerald@jobmonkey.dev>","toEmail":"={{ $('Check Status').item.json.userEmail }}","subject":"=Your JobMonkey Results are Ready!","html":"={{ $('Check Status').item.json.finalEmailBody }}","options":{"appendAttribution":false}},"type":"n8n-nodes-base.emailSend","typeVersion":2.1,"posit