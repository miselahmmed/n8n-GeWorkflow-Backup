ent":"## Step 4: Feedback to User=>\n","height":1140,"width":1460,"color":4},"type":"n8n-nodes-base.stickyNote","position":[2496,464],"typeVersion":1,"id":"5625f169-3e0f-4551-a13c-4c602a739ae0","name":"Sticky Note4"},{"parameters":{"sendTo":"={{ $json.email }}","subject":"Problem with Job Application Generation","emailType":"text","message":"=Hi {{ $('Webhook').item.json.body.name }},\n\nThere was an issue while processing your job application. Please resubmit your resume or try again later.\n\nSorry for the inconvenience!\n\nThe JobMonkey Team","options":{"appendAttribution":false}},"type":"n8n-nodes-base.gmail","typeVersion":2.1,"position":[3648,880],"id":"65c6cdcb-0cc7-4467-8871-4062448812e5","name":"Send a message if process failed","webhookId":"30267367-6078-4989-a428-54d658c0f0f7","credentials":{"gmailOAuth2":{"id":"ruloI1GkFQqksqlC","name":"Gerald/ JobMonkey<denorgerald@gmail.com>"}}},{"parameters":{"assignments":{"assignments":[{"id":"99d327d4-7bed-4b76-9150-75247e4eaf0f","name":"job_title","value":"={{ $('Webhook').item.json.body.jobSearchKeyword }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-2272,944],"id":"2cfeae0f-c8d0-484e-92a7-4ea8dfa61426","name":"Set Job Title"},{"parameters":{"content":"## Need Help?\n\n## Reach me: https://www.linkedin.com/in/gerald-akhidenor-1ab1a45/\n\n## Work with me: https://dominixai.com/\n\n## My website: https://jobmonkey.dev\n\n## My email: denorgerald@gmail.com\n","height":320,"width":820,"color":4},"type":"n8n-nodes-base.stickyNote","position":[-16,-64],"typeVersion":1,"id":"2973a6ec-af48-40a5-80e9-6591f864ab6c","name":"Sticky Note1"},{"parameters":{"fromEmail":"=  Gerald from JobMonkey <gerald@jobmonkey.dev>","toEmail":"={{ $('Check Status').item.json.userEmail }}","subject":"=Your JobMonkey Results are Ready!","html":"={{ $('Check Status').item.json.finalEmailBody }}","options":{"appendAttribution":false}},"type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[3648,640],"id":"d8f016c7-26ef-4dce-9f9e-bab2559cac9b","name":"Send email","webhookId":"a134a896-0907-45eb-887e-3c0336740dde","credentials":{"smtp":{"id":"QG1kbwZBcXAe5VV3","name":"gerald@jobmonkey.dev"}}},{"parameters":{"method":"POST","url":"https://jobmonkey.dev/wp-json/jobmonkey/v1/refund","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={{ $('Check Status').item.json.transactionId }}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[3648,1136],"id":"a6a4548b-5b27-4c00-b77b-c16dee1adb41","name":"Refund Points","credentials":{"httpHeaderAuth":{"id":"N1j0c0NPa0OEHIRv","name":"WP JobMonkey API"}}},{"parameters":{"jsCode":"// Safer approach to access data\nconst inputData = $input.all();\nconsole.log(\"Input data received:\", inputData.length, \"items\");\n\nif (inputData.length === 0) {\n  return [{\n    json: {\n      status: 'failure',\n      reason: 'No data received from collection node'\n    }\n  }];\n}\n\nconst collectedData = inputData[0].json;\nconsole.log(\"Collected data structure:\", Object.keys(collectedData));\n\nconst successfulJobs = collectedData.jobs || [];\nconsole.log(\"Jobs found:\", successfulJobs.length);\n\n// Get webhook data using items() instead of accessing directly\nconst webhookItems = $items(\"Webhook\");\nconst webhookData = webhookItems[0].json;\nconst userEmail = webhookData.body.email;\nconst userName = webhookData.body.name;\nconst transactionId = webhookData.body.transactionId;\nconst submissionId = webhookData.body.submissionId;\n\n// Rest of your email building logic stays the same...\nif (successfulJobs.length === 0) {\n  return [{\n    json: {\n      status: 'failure',\n      reason: 'No matching jobs were found to process after filtering.',\n      userEmail,\n      userName,\n      transactionId,\n      submissionId\n    }\n  }];\n}\n\n// Build email HTML (keeping your existing code)\nlet emailHtml = `\n<html>\n  <body style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #333;\">\n    <p>Hi ${userName},</p>\n    <p>Your JobMonkey request is complete! Here are the tailored resume(s) and cover letter(s) for the ${successfulJobs.length} job(s) that was/were successfully processed:</p>\n`;\n\nlet jobCounter = 1;\nfor (const jobData of successfulJobs) {\n  const jobTitle = jobData.job_title || 'Title Not Available';\n  const companyName = jobData.company_name || jobData.company || 'Company Not Available';\n  const jobUrl = jobData.job_url || '#';\n  const coverLetter = jobData.cover_letter || 'Cover letter not available';\n  const tailoredResume = jobData.tailored_resume || 'Resume not available';\n\n  emailHtml += `\n    <hr style=\"margin: 30px 0; border: 1px solid #ccc;\">\n    <h2>Job #${jobCounter}: ${jobTitle} at ${companyName}</h2>\n    <p><strong>Job URL:</strong> <a href=\"${jobUrl}\">${jobUrl}</a></p>\n    \n    <h3>Your Cover Letter:</h3>\n    <div style=\"background: #f9f9f9; padding: 15px; border: 1px solid #eee; border-radius: 8px; margin-bottom: 15px;\">\n      ${coverLetter}\n    </div>\n    \n    <h3>Your Tailored Resume:</h3>\n    <div style=\"background: #f9f9f9; padding: 15px; border: 1px solid #eee; border-radius: 8px;\">\n      ${tailoredResume}\n    </div>\n  `;\n  jobCounter++;\n}\n\nemailHtml += `\n    <hr style=\"margin-top: 30px;\">\n    <p>Good luck with your applications!</p>\n    <p>The JobMonkey Team</p>\n  </body>\n</html>\n`;\n\nreturn [{\n  json: {\n    finalEmailBody: emailHtml,\n    userEmail,\n    userName,\n    status: 'success',\n    submissionId\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2784,832],"id":"8cd8501f-31b6-4b9e-892f-7be7e3d5362c","name":"Aggregate Results"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"73a9dee4-4d64-4225-8698-36b27309a6fc","leftValue":"={{ $json.status === 'success' }}","rightValue":"","operator