,</p>\n\n<p>We're writing to let you know that there was an issue processing your recent JobMonkey request.</p>\n\n<p><strong>Reason:</strong> {{ $json.reason }}</p>\n\n<p>This can sometimes happen if no jobs matching your criteria were found, or if the jobs found were not a strong match for your resume after being scored by the AI.</p>\n\n<p>Not to worry, a refund for this request has been processed automatically.</p>\n\n<p>You are welcome to try again with a different job title or an updated resume. If you continue to experience issues, please don't hesitate to contact support by replying this email or gerald@dominixai.com.</p>\n\n<p>Thanks,<br>The JobMonkey Team</p>","options":{"appendAttribution":false}},"type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[3664,1408],"id":"553c3337-fdaa-476b-a8f6-d85b523960e7","name":"Send Failure Email","webhookId":"a149d79d-e4d7-42c6-bbc4-f6a625c06ef2","credentials":{"smtp":{"id":"QG1kbwZBcXAe5VV3","name":"gerald@jobmonkey.dev"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"d32fb6e6-a6a6-49ab-87a8-212bf055c7b2","leftValue":"={{ $json.job_title }}","rightValue":"","operator":{"type":"string","operation":"notEmpty","singleValue":true}},{"id":"d79d5dc9-f3ca-44d1-801f-fa3b2ba3b7f3","leftValue":"={{ $json.company_name }}","rightValue":"","operator":{"type":"string","operation":"notEmpty","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.filter","typeVersion":2.2,"position":[-512,912],"id":"c7027a0d-fc25-4493-9e5c-6e85ce697dda","name":"Filter Out Bad Data"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"bd5a9af0-b569-4a75-9744-20699a5021d0","leftValue":"={{ Number(JSON.parse($json.output.replace(/```(json)?\\n|```/g, '')).score) }}","rightValue":3,"operator":{"type":"number","operation":"gte"}}],"combinator":"and"},"looseTypeValidation":true,"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[928,1088],"id":"f7852f2d-7f2a-4c3a-937c-37c0fdd7c608","name":"📈 IF Score ≥ 3","alwaysOutputData":true},{"parameters":{"amount":10},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[1232,1072],"id":"245eae74-d467-4b79-9ff8-1293d4565ba1","name":"Wait1","webhookId":"6dcb9ddf-8e96-4b49-aa55-aa46695848ae"},{"parameters":{"model":{"__rl":true,"value":"o3","mode":"list","cachedResultName":"o3"},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.2,"position":[1568,1376],"id":"e8abbae7-a540-4df6-a77a-ac77d79e165e","name":"OpenAI Chat Model","credentials":{"openAiApi":{"id":"ySmjTBAwyTsi9kbr","name":"OpenAi account 1"}}},{"parameters":{"model":{"__rl":true,"value":"o3","mode":"list","cachedResultName":"o3"},"options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenAi","typeVersion":1.2,"position":[784,1360],"id":"d4c3f229-bdf5-455e-9bcf-5b54b542ebbb","name":"OpenAI Chat Model1","credentials":{"openAiApi":{"id":"ySmjTBAwyTsi9kbr","name":"OpenAi account 1"}}},{"parameters":{"promptType":"define","text":"=As an expert hiring manager, analyze the Job Description and Candidate Resume.\n\n### JOB DESCRIPTION\n{{ $json.job_description }}\n\n### CANDIDATE RESUME\n{{ $('Extract from File').item.json.text }}\n\n### INSTRUCTIONS\nReturn a single JSON object with two keys: \"skills\" and \"score\".\n- \"skills\": An array of the top skills from the job description.\n- \"score\": A number from 1 to 5 indicating how well the resume matches the job skills.\n\nExample Output:\n{\n  \"skills\": [\"Project Management\", \"Agile Methodologies\", \"JIRA\"],\n  \"score\": 4\n}","options":{}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":2,"position":[592,1088],"id":"d78a4268-e5f8-44f4-8138-0950c3d5c4a9","name":"Score Resume Match to Extracted Skills from Job Description","executeOnce":false},{"parameters":{"promptType":"define","text":"=You are an expert career writer. Based on the Job Description and the Candidate's Resume, perform the following two tasks.\n\n### ROLE DETAILS\n- Job Title: {{ $('Loop Over Items').item.json.job_title }}\n- Company: {{ $('Loop Over Items').item.json.company_name }}\n\n### CANDIDATE RESUME\n{{ $('Extract from File').item.json.text }}\n\n### INSTRUCTIONS\nFirst, rewrite the resume as a clean HTML fragment optimized for this job.\nSecond, write a persuasive, ATS-friendly cover letter as an HTML fragment for this job.\n\nStructure your entire response with the following clear headings so I can parse it easily. Do not include any other text or explanation.\n\n### REWRITTEN RESUME ###\n[The full rewritten resume HTML goes here]\n\n### COVER LETTER ###\n[The full cover letter HTML goes here]","messages":{"messageValues":[{"message":"You are an expert and helpful career writer"}]},"batching":{}},"type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.7,"position":[1440,1072],"id":"7802e7cc-20ba-4001-8acd-f772c5a557d9","name":"🔥Write Cover Letter & Rewrite Resume1"},{"parameters":{"jsCode":"// This code goes inside the \"Split cover letter from resume\" node.\n// It cleans and correctly parses the LLM output.\n\n// Get the full output from the LLM node\nconst llmOutput = $('🔥Write Cover Letter & Rewrite Resume1').item.json.text;\n\n// Clean up the output by removing the markdown code blocks and extra whitespace\nconst cleanedOutput = llmOutput.replace(/```(html)?\\n|```/g, '').trim();\n\n// Split the output into two parts based on the headings\nconst parts = cleanedOutput.split('### COVER LETTER ###');\n\n// Extract the resume and remove the resume heading\nconst resumeHtml = parts[0].replace('### REWRITTEN RESUME ###', '').trim();\n\n// Extract the cover letter and remove any extra whitespace\nconst coverLetterHtml = parts[1].trim();\n\n// Return the job data with the new, correctly separated properties\nreturn [{\n  json: {\n    job_title: $('Loop Over Items').item.json.job_title || \"Title Not Found\",\n    company_name: $('Loop Over Items').item.json.company_name || \"Company Not Found\",\n    job_url: $('Loop Over Items').item.json.job_url || \"#\",\n    job_description: $('Loop Over Items').item.json.job_description,\n    email: $('Webhook').item.json.body.email,\n    cover_letter: coverLetterHtml,\n    tailored_resume: resumeHtml\n  }\n}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1776,1072],"id":"251fa844-b30d-43d9-a8a2-ba7e767b8ceb","name":"Split cover letter from resume"},{"parameters":{"jsCode":"// Debug version - collect all jobs after loop completes\nconsole.log(\"=== COLLECTING ALL JOBS ===\");\n\ntry {\n  // Get all processed jobs from \"Prepare Final Job\" node\n  const jobResults = $items(\"Prepare Final Job\");\n  console.log(\"Total items from Prepare Final Job:\", jobResults.length);\n  \n  const allJobs = [];\n  jobResults.forEach((item, index) => {\n    if (item && item.json) {\n      console.log(`Job ${index + 1}:`, item.json.job_title);\n      allJobs.push({\n        job_title: item.json.job_title || \"Title Not Found\",\n        company_name: item.json.company_name || \"Company Not Found\",\n        job_url: item.json.job_url || \"#\",\n        job_description: item.json.job_description || \"No description\",\n        cover_letter: item.json.cover_letter || \"Cover letter not available\",\n        tailored_resume: item.json.tailored_resume || \"Resume not available\",\n        email: item.json.email || \"\"\n      });\n    }\n  });\n  \n  console.log(\"FINAL RESULT: Collected\", allJobs.length, \"jobs\");\n  \n  return [{\n    json: {\n      jobs: allJobs,\n      totalProcessed: allJobs.length\n    }\n  }];\n  \n} catch (error) {\n  console.log(\"Collection error:\", error.message);\n  return [{\n    json: {\n      jobs: [],\n      totalProcessed: 0,\n      error: error.message\n    }\n  }];\n}"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1504,832],"id":"e7377545-fe30-42f8-b866-e340651ff76a","name"