026","name":"Score Resume Match to Extracted Skills from Job Description","executeOnce":false},{"parameters":{"promptType":"define","text":"=You are an expert career writer. Based on the Job Description and the Candidate's Resume, perform the following two tasks.\n\n### ROLE DETAILS\n- Job Title: {{ $('Loop Over Items').item.json.job_title }}\n- Company: {{ $('Loop Over Items').item.json.company_name }}\n\n### CANDIDATE RESUME\n{{ $('Extract from File').item.json.text }}\n\n### INSTRUCTIONS\nFirst, rewrite the resume as a clean HTML fragment optimized for this job.\nSecond, write a persuasive, ATS-friendly cover letter as an HTML fragment for this job.\n\nStructure your entire response with the following clear headings so I can parse it easily. Do not include any other text or explanation.\n\n### REWRITTEN RESUME ###\n[The full rewritten resume HTML goes here]\n\n### COVER LETTER ###\n[The full cover letter HTML goes here]","messages":{"messageValues":[{"message":"You are an expert and helpful career writer"}]},"batching":{}},"type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.7,"position":[1888,560],"id":"7b2b1d32-3052-4f87-be85-5e498e03bff7","name":"🔥Write Cover Letter & Rewrite Resume1"},{"parameters":{"jsCode":"// This code goes inside the \"Split cover letter from resume\" node.\n// It cleans and correctly parses the LLM output.\n\n// Get the full output from the LLM node\nconst llmOutput = $('🔥Write Cover Letter & Rewrite Resume1').item.json.text;\n\n// Clean up the output by removing the markdown code blocks and extra whitespace\nconst cleanedOutput = llmOutput.replace(/```(html)?\\n|```/g, '').trim();\n\n// Split the output into two parts based on the headings\nconst parts = cleanedOutput.split('### COVER LETTER ###');\n\n// Extract the resume and remove the resume heading\nconst resumeHtml = parts[0].replace('### REWRITTEN RESUME ###', '').trim();\n\n// Extract the cover letter and remove any extra whitespace\nconst coverLetterHtml = parts[1].trim();\n\n// Return the job data with the new, correctly separated properties\nreturn [{\n  json: {\n    job_title: $('Loop Over Items').item.json.job_title || \"Title Not Found\",\n    company_name: $('Loop Over Items').item.json.company_name || \"Company Not Found\",\n    job_url: $('Loop Over Items').item.json.job_url || \"#\",\n    job_description: $('Loop Over Items').item.json.job_description,\n    email: $('Webhook').item.json.body.email,\n    cover_letter: coverLetterHtml,\n    tailored_resume: resumeHtml\n  }\n}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2224,560],"id":"05eeebe6-728b-4376-bbfb-f1a7cde58e68","name":"Split cover letter from resume"},{"parameters":{"jsCode":"// Debug version - collect all jobs after loop completes\nconsole.log(\"=== COLLECTING ALL JOBS ===\");\n\ntry {\n  // Get all processed jobs from \"Prepare Final Job\" node\n  const jobResults = $items(\"Prepare Final Job\");\n  console.log(\"Total items from Prepare Final Job:\", jobResults.length);\n  \n  const allJobs = [];\n  jobResults.forEach((item, index) => {\n    if (item && item.json) {\n      console.log(`Job ${index + 1}:`, item.json.job_title);\n      allJobs.push({\n        job_title: item.json.job_title || \"Title Not Found\",\n        company_name: item.json.company_name || \"Company Not Found\",\n        job_url: item.json.job_url || \"#\",\n        job_description: item.json.job_description || \"No description\",\n        cover_letter: item.json.cover_letter || \"Cover letter not available\",\n        tailored_resume: item.json.tailored_resume || \"Resume not available\",\n        email: item.json.email || \"\"\n      });\n    }\n  });\n  \n  console.log(\"FINAL RESULT: Collected\", allJobs.length, \"jobs\");\n  \n  return [{\n    json: {\n      jobs: allJobs,\n      totalProcessed: allJobs.length\n    }\n  }];\n  \n} catch (error) {\n  console.log(\"Collection error:\", error.message);\n  return [{\n    json: {\n      jobs: [],\n      totalProcessed: 0,\n      error: error.message\n    }\n  }];\n}"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1952,320],"id":"2cc9ad68-3782-49e5-b4ef-279077423d2d","name":"Collect jobs into one array"},{"parameters":{"assignments":{"assignments":[{"id":"b8e5d118-e34e-4e15-a3b1-27c313438720","name":"collection_ready","value":true,"type":"boolean"},{"id":"473aa8f5-36ce-4e4b-8e3c-979b519c7f3a","name":"total_jobs_processed","value":"={{ $('Loop Over Items').item.json.batchSize || 0 }}","type":"number"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1216,320],"id":"bf5f5095-94ef-4654-9782-bd780a83c096","name":"Gather jobs before sending"}],"connections":{"Filter Duplicates":{"main":[[{"node":"Job Feed Limiter","type":"main","index":0}]]},"Upate sheets":{"main":[[{"node":"Wait","type":"main","index":0}]]},"Extract from File":{"main":[[{"node":"Set Job Title","type":"main","index":0}]]},"Apify: Run Indeed Scraper":{"main":[[{"node":"Apify: Get Indeed Results","type":"main","index":0}]]},"Apify: Get Indeed Results":{"main":[[{"node":"Merge","type":"main","index":0}]]},"Apify: Run LinkedIn Scraper":{"main":[[{"node":"Apify: Get LinkedIn Results","type":"main","index":0}]]},"Apify: Run Upwork Scraper":{"main":[[{"node":"Apify: Get Upwork Results","type":"main","index":0}]]},"Apify: Run Glassdoor Scraper":{"main":[[{"node":"Apify: Get Glassdoor Results","type":"main","index":0}]]},"Apify: Get Upwork Results":{"main":[[{"node":"Merge","type":"main","index":2}]]},"Merge":{"main":[[{"node":"Filter","type":"main","index":0}]]},"Standardize Job Data":{"main":[[{"node":"Filter Out Bad Data","type":"main","index":0}]]},"Filter":{"main":[[{"node":"Standardize Job Data","type":"main","index":0}]]},"Apify: Get LinkedIn Results":{"main":[[{"node":"Merge","type":"main","index":1}]]},"Itemize List":{"main":[[{"node":"Merge","type":"main","index":3}]]},"Respond to Webhook":{"main":[[{"node":"Extract from File","type":"main","index":0}]]},"Loop Over Items":{"main":[[{"node