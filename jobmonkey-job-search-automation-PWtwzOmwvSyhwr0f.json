{"createdAt":"2025-08-29T04:32:43.968Z","updatedAt":"2025-08-29T05:26:16.000Z","id":"PWtwzOmwvSyhwr0f","name":"Indeed.com(NG)/JobMonkey Job Search Automation","active":true,"isArchived":false,"nodes":[{"parameters":{"jsCode":"const seen = new Set();\n\nfunction normalizeText(text) {\n  return text.toLowerCase()\n    .trim()\n    .replace(/[^\\w\\s]/g, '') // Remove special characters\n    .replace(/\\s+/g, ' ');   // Normalize whitespace\n}\n\nreturn items.filter(item => {\n  const job = item.json;\n  \n  // Extract with fallbacks and normalize\n  const title = normalizeText(\n    job.title || job.jobTitle || job.job_title || job.name || \n    job.position || job.positionTitle || job.role || job.jobName ||\n    job.job?.title || ''\n  );\n  \n  const company = normalizeText(\n    job.company || job.companyName || job.company_name || \n    job.employer || job.organization || job.job?.company || ''\n  );\n  \n  const description = normalizeText(\n    (job.description || job.jobDescription || job.job_description || \n     job.summary || job.details || job.job?.description || '')\n    .substring(0, 100)\n  );\n  \n  // Skip if we don't have enough data to create a meaningful key\n  if (!title && !company) {\n    return true; // Keep items we can't properly identify\n  }\n  \n  const key = `${title}-${company}-${description}`;\n  \n  if (seen.has(key)) {\n    return false;\n  }\n  seen.add(key);\n  return true;\n});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[160,400],"id":"e117c203-523d-4ea2-91c2-5e1b8ae18cdf","name":"Filter Duplicates"},{"parameters":{"operation":"update","documentId":{"__rl":true,"value":"1G4cbIHcPc1Du8oJmf5h7DKDuJ2jzzs73tM2WEnSsPJg","mode":"list","cachedResultName":"Job Search Automation Product Database","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1G4cbIHcPc1Du8oJmf5h7DKDuJ2jzzs73tM2WEnSsPJg/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":1612746852,"mode":"list","cachedResultName":"update sheet","cachedResultUrl":"