<gerald@jobmonkey.dev>","toEmail":"={{ $('Check Status').item.json.userEmail }}","subject":"=  An Issue with Your JobMonkey Request","html":"=<p>Hi {{ $json.userName }},</p>\n\n<p>We're writing to let you know that there was an issue processing your recent JobMonkey request.</p>\n\n<p><strong>Reason:</strong> {{ $json.reason }}</p>\n\n<p>This can sometimes happen if no jobs matching your criteria were found, or if the jobs found were not a strong match for your resume after being scored by the AI.</p>\n\n<p>Not to worry, a refund for this request has been processed automatically.</p>\n\n<p>You are welcome to try again with a different job title or an updated resume. If you continue to experience issues, please don't hesitate to contact support by replying this email or gerald@dominixai.com.</p>\n\n<p>Thanks,<br>The JobMonkey Team</p>","options":{"appendAttribution":false}},"type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[4112,896],"id":"b7c804ab-92b8-40a8-9502-b2949649437f","name":"Send Failure Email","webhookId":"b52bd41c-57cd-4472-ae36-e7336a1206ec","credentials":{"smtp":{"id":"QG1kbwZBcXAe5VV3","name":"gerald@jobmonkey.dev"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"d32fb6e6-a6a6-49ab-87a8-212bf055c7b2","leftValue":"={{ $json.job_title }}","rightValue":"","operator":{"type":"string","operation":"notEmpty","singleValue":true}},{"id":"d79d5dc9-f3ca-44d1-801f-fa3b2ba3b7f3","leftValue":"={{ $json.company_name }}","rightValue":"","operator":{"type":"string","operation":"notEmpty","singleValue":true}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.filter","typeVersion":2.2,"position":[-64,400],"id":"7fb5d8ea-8dea-43b0-baa1-d1e797387f98","name":"Filter Out Bad Data"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"bd5a9af0-b569-4a75-9744-20699a5021d0","leftValue":"