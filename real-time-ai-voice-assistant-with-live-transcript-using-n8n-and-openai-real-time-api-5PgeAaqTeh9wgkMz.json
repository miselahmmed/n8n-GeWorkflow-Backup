{"createdAt":"2025-07-16T18:33:42.941Z","updatedAt":"2025-08-17T13:41:55.000Z","id":"5PgeAaqTeh9wgkMz","name":"Real-Time AI Voice Assistant with Live Transcript using N8N and OpenAI real-time API","active":true,"isArchived":false,"nodes":[{"parameters":{"method":"POST","url":"https://api.openai.com/v1/realtime/sessions","authentication":"predefinedCredentialType","nodeCredentialType":"openAiApi","sendBody":true,"specifyBody":"json","jsonBody":"{\n      \"instructions\": \"You are a friendly assistant.\",\n      \"model\": \"gpt-4o-realtime-preview-2024-12-17\",\n      \"modalities\": [\"audio\", \"text\"],\n      \"voice\": \"alloy\",\n      \"input_audio_transcription\": {\n          \"model\": \"whisper-1\"\n      }\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[200,0],"id":"2d504dbf-c133-4beb-af42-5cf86661b944","name":"HTTP Request","credentials":{"openAiApi":{"id":"ySmjTBAwyTsi9kbr","name":"OpenAi account"}}},{"parameters":{"path":"realtime-ai","responseMode":"responseNode","options":{"allowedOrigins":"*"}},"type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,0],"id":"933b3d47-daee-4213-8e9e-06cc2ab9d07b","name":"Webhook","webhookId":"32b73c7b-424e-4ed7-aa29-25ffbb46f1ee"},{"parameters":{"html":"<!DOCTYPE html>\n\n<html>\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>NanoAI RT</title>\n  \n  <style>\n.container {\n  background-color: #ffffff;\n  text-align: left;\n  padding: 16px;\n  border-radius: 8px;\n}\n\n.msg\n{\n    padding: 5px; \n    background-color: #eee;\n}\n\n.msgUsr\n{\n    padding: 5px; \n    background-color: #e4eefd;\n}\n    \n.curMsg\n{\n    padding: 5px; \n    background-color: #e6ffd9;\n}\n\n\n\nh1 {\n    margin: 5px;\n    font-size: 20px;\n}\n\n</style>\n\n</head>\n<body>\n    \n  <H1>Let's talk!</H1>\n  <div class=\"container\">\n\n    <div class=\"messages\"></div>\n    \n    <div class=\"curMsg\"></div>    \n    \n    \n\n  </div>\n  \n  \n\n<script>\nasync function init() {\n  // Get an ephemeral key from your server - see server code below\n  const EPHEMERAL_KEY = \"{{ $json.client_secret.value }}\";\n\n  // Create a peer connection\n  const pc = new RTCPeerConnection();\n\n  // Set up to play remote audio from the model\n  const audioEl = document.createElement(\"audio\");\n  audioEl.autoplay = true;\n  pc.ontrack = e => audioEl.srcObject = e.streams[0];\n\n  // Add local audio track for microphone input in the browser\n  const ms = await navigator.mediaDevices.getUserMedia({\n    audio: true\n  });\n  pc.addTrack(ms.getTracks()[0]);\n\n  // Set up data channel for sending and receiving events\n  const dc = pc.createDataChannel(\"oai-events\");\n  dc.addEventListener(\"message\", (e) => {\n    // Realtime server events appear here!\n    console.log(e);\n    handleResponse(e);\n  });\n\n  // Start the session using the Session Description Protocol (SDP)\n  const offer = await pc.createOffer();\n  await pc.setLocalDescription(offer);\n\n  const baseUrl = \"https://api.openai.com/v1/realtime\";\n  const model = \"gpt-4o-realtime-preview-2024-12-17\";\n  const sdpResponse = await fetch(`${baseUrl}?model=${model}`, {\n    method: \"POST\",\n    body: offer.sdp,\n    headers: {\n      Authorization: `Bearer ${EPHEMERAL_KEY}`,\n      \"Content-Type\": \"application/sdp\"\n    },\n  });\n\n  const answer = {\n    type: \"answer\",\n    sdp: await sdpResponse.text(),\n  };\n  await pc.setRemoteDescription(answer);\n}\n\n\nfunction handleResponse(e)\n{\n    var obj = JSON.parse(e.data);\n    \n    \n    if ( obj.type == 'response.audio_transcript.done')\n    {\n        document.querySelector('.curMsg').innerHTML = \"\";\n        document.querySelector('.messages').innerHTML += \"<div class='msg'>AI: \" + obj.transcript + \"</div><br/>\";\n        \n        //add a line break after a sentence\n        //document.querySelector('.messages').innerHTML += \"<br/>\";\n\n    }\n\n  if ( obj.type == 'conversation.item.input_audio_transcription.completed')\n    {\n        document.querySelector('.curMsg').innerHTML = \"\";\n        document.querySelector('.messages').innerHTML += \"<div class='msgUsr'>User: \" + obj.transcript + \"</div><br/>\";\n        \n        //add a line break after a sentence\n        //document.querySelector('.messages').innerHTML += \"<br/>\";\n\n    }\n    \n    if ( obj.type == 'response.audio_transcript.delta')\n    {\n        document.querySelector('.curMsg').innerHTML += obj.delta;\n\n    }\n  \n    if ( obj.type == 'conversation.item.input_audio_transcription.delta')\n    {\n        document.querySelector('.curMsg').innerHTML += obj.delta;\n\n    }\n  \n}\n\ninit();\n\n\n\n\n\n</script>\n\n\n\n\n  \n</body>\n</html>"},"type":"n8n-nodes-base.html","typeVersion":1.2,"position":[480,0],"id":"8c1d084f-a9a5-465b-a430-034209510193","name":"HTML"},{"parameters":{"respondWith":"text","responseBody":"={{ $json.html }}","options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[700,0],"id":"1c3fcf12-4476-4963-b765-b0690e4dbc52","name":"Respond to Webhook"},{"parameters":{},"type":"n8n-nodes-base.stickyNote","position":[380,-20],"typeVersion":1,"id":"6fc12089-d56c-4d5c-9f22-1936000826d4","name":"Sticky Note"},{"parameters":{"content":"## The source\n**https://blog.elest.io/build-your-own-real-time-ai-voice-assistant-with-live-transcript-using-n8n-and-openai-real-time-api/** "},"type":"n8n-nodes-base.stickyNote","position":[160,-240],"typeVersion":1,"id":"92c70137-8b5e-41ea-8c51-5d46037e5a75","name":"Sticky Note1"}],"connections":{"Webhook":{"main":[[{"node":"HTTP Request","type":"main","index":0}]]},"HTML":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]},"HTTP Request":{"main":[[{"node":"HTML","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":null,"pinData":{},"versionId":"ad12f848-4488-4941-97d7-2756248b3bb6","triggerCount":1,"shared":[{"createdAt":"2025-07-16T18:33:42.957Z","updatedAt":"2025-07-16T18:33:42.957Z","role":"workflow:owner","workflowId":"5PgeAaqTeh9wgkMz","projectId":"roCKyeuuwaNdcgDf"}],"tags":[]}