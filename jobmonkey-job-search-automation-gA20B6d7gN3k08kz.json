CoverLetter: cleanedCoverLetter,\n    cleanedResume: cleanedResume\n  }\n}));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[224,-240],"id":"6aebdc04-e9d7-4c0e-9c5d-776c36480d8e","name":"Clean Up HTML"},{"parameters":{"model":"openai/gpt-oss-20b:free","options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenRouter","typeVersion":1,"position":[464,304],"id":"9adb0e38-f6f3-455c-b800-61aab40e490f","name":"OpenRouter Chat Model2","credentials":{"openRouterApi":{"id":"5PDv0ZxYOLkxlcrr","name":"OpenRouter account"}}},{"parameters":{"content":"## Step 3: Analyze Job, Match Resume to Job and Write a Customized Resume for the New Job=>\n","height":784,"width":2212,"color":5},"type":"n8n-nodes-base.stickyNote","position":[-784,-320],"typeVersion":1,"id":"6d21a202-3b68-4059-a37d-d9f8e6e8fbd9","name":"Sticky Note5"},{"parameters":{"content":"## Step 2: Retrieve Job Data from Various job Boards Via API=>\n","height":784,"width":700,"color":5},"type":"n8n-nodes-base.stickyNote","position":[-1504,-320],"typeVersion":1,"id":"2ba7642f-f31d-4a65-819a-e3ef371ad9ac","name":"Sticky Note7"},{"parameters":{"promptType":"define","text":"=You are an expert career writer. Based on the Job Description and the Candidate's Resume, perform the following two tasks.\n\n### ROLE DETAILS\n- Job Title: {{ $('Loop Over Items').item.json.job_title }}\n- Company: {{ $('Loop Over Items').item.json.company_name }}\n\n### CANDIDATE RESUME\n{{ $('Extract from File').item.json.text }}\n\n### JOB DESCRIPTION\n{{ $('Loop Over Items').item.json.job_description }}\n\n### INSTRUCTIONS\nFirst, write a persuasive, ATS-friendly cover letter as an HTML fragment for this job: {{ $('Loop Over Items').item.json.job_description }} or {{ $('Loop Over Items').item.json.job_title }}.\n\nSecond, rewrite the resume as a clean HTML fragment optimized for this job: {{ $('Loop Over Items').item.json.job_description }} or {{ $('Loop Over Items').item.json.job_title }}.\n\nStructure your entire response with the following clear headings so I can parse it easily. Do not include any other text or explanation.\n\n### REWRITTEN RESUME ###\n[The full rewritten resume HTML goes here]\n\n### COVER LETTER ###\n[The full cover letter HTML goes here]","messages":{"messageValues":[{"message":"You are an expert and helpful career writer"}]},"batching":{}},"type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.7,"position":[752,-64],"id":"2fd3d5d1-6c4f-4667-93b4-2693214fb469","name":"🔥Write Cover Letter & Rewrite Resume"},{"parameters":{"assignments":{"assignments":[{"id":"1d94debe-7ad2-4e42-8a2f-c4be2e17147e","name":"=cleanedCoverLetter","value":"={{ $json.cleanedCoverLetter }}","type":"string"},{"id":"577aea4f-e6de-4941-adbe-faa9ded51bb6","name":"=cleanedResume","value":"={{ $json.cleanedResume }}","type":"string"},{"id":"bba8b0d2-d7a0-4872-b951-67f88e4ed677","name":"=job_title","value":"={{ $('Apify: Get LinkedIn Results1').item.json.title }}","type":"string"},{"id":"8bf5d113-807e-4187-b28e-e54e1283f990","name":"=company_name","value":"={{ $('Apify: Get LinkedIn Results1').item.json.company }}","type":"string"},{"id":"6a6c715f-44db-42b2-a3ef-717d75753239","name":"allJobs","value":"={{ $json }}","type":"string"},{"id":"51ab92f7-5ca7-4f17-a6bd-b9268326aa93","name":"recipientEmail","value":"={{ $('Webhook').item.json.body.Email }}","type":"string"},{"id":"b55eab5b-73d6-476d-afe0-620635e0c23c","name":"recipientName","value":"={{ $('Webhook').item.json.body.Name }}","type":"string"},{"id":"3274da94-8809-4a27-8f63-8b8f04a0ecc4","name":"jobUrl","value":"={{ $('Apify: Get LinkedIn Results1').item.json.link }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[512,-240],"id":"2525ea07-89e5-4a44-97db-aa295ddcd773","name":"Edit Fields"},{"parameters":{},"type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[1536,48],"id":"ffbbc93a-3943-4ee8-ae42-403dbe011777","name":"Collect All Applications"},{"parameters":{"jsCode":"// The 'items' array contains all the successfully processed job items\n// from the Collect All Applications (Merge) node.\n\n// 1. Get Webhook Data for the email header (Use the global $() function)\nconst webhookData = $('Webhook').item.json.body;\nconst recipientEmail = webhookData.Email;\nconst recipientName = webhookData.Name;\n\n// 2. Declare the array for aggregated jobs\nconst reformattedJobs = [];\n\n// 3. Process all incoming job items\nitems.forEach((item, index) => {\n  const job = item.json;\n  \n  // FIX: Safely retrieve the company name, assuming it's now a clean string or object property\n  let companyName = job.company_name;\n\n  if (typeof companyName === 'object' && companyName !== null) {\n      // If it somehow still comes in as an object (e.g., from a different scraper)\n      companyName = companyName.name || companyName.universalName || 'Unknown Company';\n  }\n\n  // Handle case where AI output fields might be empty or missing due to upstream failure\n  const coverLetter = job.cleanedCoverLetter || '*** No cover letter was generated, possibly due to a missing Job Description or a filter rule. ***';\n  const resume = job.cleanedResume || '*** No tailored resume was generated. ***';\n\n\n  // Create a structured object for each job application and push to the array\n  reformattedJobs.push({\n    number: index + 1, // Number the applications\n    job_title: job.job_title || 'Unknown Job Title',\n    company_name: String(companyName), \n    jobUrl: job.jobUrl, \n    cleanedCoverLetter: coverLetter,\n    cleanedResume: resume,\n  });\n});\n\n// 4. Return a single output item.\nreturn [{\n  json: {\n    totalJobs: reformattedJobs.length,\n    allJobs: reformattedJobs,\n    // Pass along necessary data for the email header\n    recipientEmail: recipientEmail, \n    recipientName: recipientName,\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1760,48],"id":"50f66bd2-5e20-421b-a41a-1d2759c74b61","name":"Build Combined Email HTML"},{"parameters":{"fromEmail":"Gerald/ JobMonkey<gerald@jobmonkey.dev>","toEmail":"={{ $json.recipientEmail }}","subject":"={{ $json.totalJobs }} Job Applications/Cover Letters Ready for Review!","html":"=<html>\n  <head>\n    <link href=\"https://fonts.googleapis.com/css2?family=Raleway:wght@400;700&display=swap\" rel=\"stylesheet\">\n  </head>\n  <body style=\"font-family: 'Raleway', sans-serif; line-height: 1.6; color: #333;\">\n    \n    <p>Hi {{ $json.recipientName || 'there' }},</p>\n    <p>\n      As requested, below are your <strong>{{ $json.totalJobs }}</strong> tailored job applications ready for review:\n    </p>\n    \n    {{ $json.allJobs.reduce((html, job) => {\n        return html + `\n          <hr style=\"margin: 30px 0; border: 2px solid #ddd;\">\n          <h2 style=\"font-size: 18px;\">Application #${job.number}: ${job.job_title} at ${job.company_name}</h2>\n          \n          <p><strong>Your Cover Letter:</strong></p>\n          <div style=\"background: #f9f9f9; padding: 15px; border: 1px solid #ccc; margin-bottom: 20px; white-space: pre-wrap;\">\n            ${job.cleanedCoverLetter}\n          </div>\n          \n          <p><strong>Your Tailored Resume:</strong></p>\n          <div style=\"background: #f9f9f9; padding: 15px; border: 1px solid #ccc; margin-bottom: 20px; white-space: pre-wrap;\">\n            ${job.cleanedResume}\n          </div>\n          \n          <p>\n            🔗 <a href=\"${job.jobUrl}\" target=\"_blank\" style=\"color: #1a0dab;\">\n              View Original Job Posting\n            </a>\n          </p>\n        `;\n    }, '') }}\n    \n    <hr style=\"margin-top: 30px;\">\n    <p><strong>NEXT STEPS:</strong></p>\n    <ul>\n      <li>Review all <strong>{{ $json.totalJobs }}</strong> applications above.</li>\n      <li>Copy and paste the materials into your application for each job.</li>\n      <li>Click the \"View Original Job Posting\" links to apply for the jobs.</li>\n    </ul>\n    \n    <p>Thank you - The JobMonky Team</p>\n  </body>\n</html>","options":{"appendAttribution":false}},"type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1984,48],"id":"4e33d165-9fd4-4175-bbf8-ede184508059","name":"Send Combined Applications","webhookId":"2ae26ccb-655b-4669-8658-a3d609c5e264","credentials":{"smtp":{"id":"QG1kbwZBcXAe5VV3","name":"gerald@jobmonkey.dev"}}},{"parameters":{"resource":"Datasets","datasetId":"={{ $json.defaultDatasetId }}","limit":null},"type":"@apify/n8n-nodes-apify.apify","typeVersion":1,"position":[-1184,-48],"id":"e87a021a-1440-4eee-92f8-c276abd4cd2e","name":"Apify: Get LinkedIn Results1","credentials":{"apifyApi":{"id":"2xcqVAa5VnPvmUtO","name":"Apify API denorgerald"}}},{"parameters":{"fromEmail":"Gerald/ JobMonkey<gerald@jobmonkey.dev>","toEmail":"={{ $('Webhook').item.json.body.Email }}","subject":"=Problem with Job Application Generation","html":"=Hi {{ $('Webhook').item.json.body.Name }},\n\nThere was an issue while processing your job application. Please try again or contact the admin.\n\nWe apologize for the inconvenience!\n\nThe JobMonkey Team\n","options":{"appendAttribution":false}},"type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[2432,48],"id":"3fed34ff-22e0-4986-8de0-71e72ad86412","name":"Send a message if process failed1","webhookId":"2ae26ccb-655b-4669-8658-a3d609c5e264","credentials":{"smtp":{"id":"QG1kbwZBcXAe5VV3","name":"gerald@jobmonkey.dev"}}},{"parameters":{"actorSource":"store","actorId":{"__rl":true,"value":"4NagaIHzI0lwMxdrI","mode":"id"},"customBody":"={\n    \"avoid_duplicates\": true,\n    \"keywords\": \"{{ $('Webhook').item.json.body['Search Keyword'] }}\",\n    \"location\": \"Nigeria\",\n    \"max_jobs\": 20\n}","waitForFinish":false},"type":"@apify/n8n-nodes-apify.apify","typeVersion":1,"position":[-1408,-48],"id":"e74d38d0-fb74-45bd-b6d8-28065232292c","name":"Apify: Run LinkedIn Scraper","credentials":{"apifyApi":{"id":"2xcqVAa5VnPvmUtO","name":"Apify API denorgerald"}}},{"parameters":{"conditions":{"options":{"caseSensitive":true,"