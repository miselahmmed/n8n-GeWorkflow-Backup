{"createdAt":"2025-10-27T08:56:35.741Z","updatedAt":"2025-10-27T09:03:24.000Z","id":"GuWfhVUGBwVYcraY","name":"Social Media Analytics & Strategy Engine","active":false,"isArchived":false,"nodes":[{"parameters":{"content":"## MULTI-PLATFORM SOCIAL MEDIA ANALYTICS & STRATEGY","height":80,"width":720,"color":5},"type":"n8n-nodes-base.stickyNote","position":[-260,-320],"typeVersion":1,"id":"50e9ec23-038a-4f93-b7a1-456709928da1","name":"Sticky Note"},{"parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":6}]}},"type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[-500,40],"id":"fee002bd-f571-4d47-b103-d06146eef476","name":"Analytics Scheduler"},{"parameters":{"assignments":{"assignments":[{"id":"f3c05b9e-df14-4ba0-8a4e-7e30fe81b809","name":"instagram_account_id","value":"@dominixai","type":"string"},{"id":"28d6c6e2-f303-401d-988d-278360a597f7","name":"twitter_username","value":"@denorgerald","type":"string"},{"id":"29456ceb-b308-48dc-bcc9-5061a488f3c4","name":"linkedin_profile_id","value":"gerald-akhidenor-1ab1a45","type":"string"},{"id":"4606d4e3-6aab-42f8-83a1-318d080aa695","name":"reddit_username","value":"@faveaigbe","type":"string"},{"id":"be9c08ce-c665-49de-87f8-2f9f282ba44f","name":"youtube_channel_id","value":"UCBJhgWKZS-cGmK2cYfqLjHw","type":"string"},{"id":"7cdec07f-b04a-4d0f-bb22-3dbaeb8fde19","name":"competitor_twitter_username","value":"fffff","type":"string"},{"id":"1199f7f7-88b5-43d1-9b2c-bc0ce7311be3","name":"google_sheet_id","value":"fffff","type":"string"},{"id":"2c7a1fef-b450-4548-aad5-7a5ee87a144d","name":"slack_channel","value":"fffff","type":"string"},{"id":"af0e6da1-8631-4017-bd11-e35a5aef94a8","name":"alerts_slack_channel","value":"fffff","type":"string"},{"id":"6660cf73-0eed-4a0a-961c-ba34f068247c","name":"sender_email","value":"gerald@dominixai.com","type":"string"},{"id":"41cfcc0f-838a-4584-8e82-6bea25dee45a","name":"recipient_email","value":"denorgerald@gmail.com","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-280,40],"id":"aee0afbf-3b24-4014-a15f-0e49523425c9","name":"📋 Configuration Variables"},{"parameters":{"content":"## Stage 1: Initial Setup & Configuration","height":420,"width":260,"color":5},"type":"n8n-nodes-base.stickyNote","position":[-470,-220],"typeVersion":1,"id":"d4603d8d-204a-49ee-944b-35978b25822e","name":"Sticky Note1"},{"parameters":{"assignments":{"assignments":[{"id":"a390e7fa-4ffc-4e77-952f-56262a56bbd2","name":"timestamp","value":"={{ new Date().toISOString() }}","type":"string"},{"id":"5bdb0163-a4a2-4fc2-a4e0-815b323b005c","name":"run_id","value":"={{ $runIndex }}_{{ new Date().getTime() }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-60,40],"id":"20d64f77-9be4-4cc4-9f32-92ce1188bc04","name":"Initialize Variables"},{"parameters":{"content":"## Step 2: Get Data","height":420,"width":180,"color":5},"type":"n8n-nodes-base.stickyNote","position":[-100,-220],"typeVersion":1,"id":"fae1c6af-5c60-429f-a7da-26aedd889a86","name":"Sticky Note2"},{"parameters":{"content":"## Stage 3: Normalize the Data with a Code Node","height":420,"width":180,"color":5},"type":"n8n-nodes-base.stickyNote","position":[120,-220],"typeVersion":1,"id":"44618929-877e-4056-b1d4-19e6bb1c4968","name":"Sticky Note3"},{"parameters":{"operation":"get","channelId":"={{ $('📋 Configuration Variables').item.json.youtube_channel_id }}","part":["*","contentDetails"]},"type":"n8n-nodes-base.youTube","typeVersion":1,"position":[160,40],"id":"2fac368d-4bed-4e73-b3c6-b5d68cb9771b","name":"Get Channel Info","credentials":{"youTubeOAuth2Api":{"id":"rkB62VyFuWbcFnio","name":"YouTube account"}}},{"parameters":{"resource":"playlistItem","operation":"getAll","playlistId":"={{ $('Get Channel Info').item.json.contentDetails.relatedPlaylists.uploads }}","part":["*","snippet","contentDetails","id","status"],"returnAll":true,"options":{}},"type":"n8n-nodes-base.youTube","typeVersion":1,"position":[380,40],"id":"672f1616-d538-499f-a4b6-aea5b0737718","name":"Get All Videos","credentials":{"youTubeOAuth2Api":{"id":"rkB62VyFuWbcFnio","name":"YouTube account"}}},{"parameters":{"jsCode":"const items = $input.all();\nconst normalizedPosts = [];\n\n// Loop through each video from the previous node\nfor (const item of items) {\n  const videoData = item.json;\n\n  // Create a new, clean object for our standardized data\n  const normalizedPost = {\n    platform: 'youtube',\n    post_id: videoData.snippet.resourceId.videoId,\n    post_url: `https://www.youtube.com/watch?v=${videoData.snippet.resourceId.videoId}`,\n    caption: videoData.snippet.title,\n    post_date: videoData.snippet.publishedAt,\n    post_type: 'video',\n    // Use parseInt to convert text stats to numbers, and handle cases where they might be missing (|| 0)\n    likes: parseInt(videoData.statistics?.likeCount) || 0,\n    comments: parseInt(videoData.statistics?.commentCount) || 0,\n    views: parseInt(videoData.statistics?.viewCount) || 0,\n    shares: 0 // YouTube API doesn't provide shares directly\n  };\n\n  // Add the clean post to our list\n  normalizedPosts.push({ json: normalizedPost });\n}\n\n// Return the full list of clean posts\nreturn normalizedPosts;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[600,40],"id":"bdf0d321-189d-41a1-a8ee-d20ed7c7f969","name":"Normalize YouTube Data"},{"parameters":{"jsCode":"const items = $input.all();\nconst posts = items.map(item => item.json);\n\n// Calculate a performance score for each video.\n// We give more weight to comments and likes than to views.\nfor (const post of posts) {\n  const views = post.views || 0;\n  const likes = post.likes || 0;\n  const comments = post.comments || 0;\n\n  // You can adjust the weights (10 and 20) to fit your strategy\n  post.performance_score = views + (likes * 10) + (comments * 20);\n}\n\n// Sort the posts from highest score to lowest score\nconst sortedPosts = posts.sort((a, b) => b.performance_score - a.performance_score);\n\n// Return the sorted list as n8n items\nreturn sortedPosts.map(post => ({ json: post }));"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[820,40],"id":"d12f9f4e-8ac6-4108-8384-d0342e0866e7","name":"Engagement Analysis"},{"parameters":{"fromEmail":"=Gerald from DominixAI <{{ $('📋 Configuration Variables').item.json.sender_email }}>","toEmail":"={{ $('📋 Configuration Variables').item.json.recipient_email }}","subject":"=YouTube Performance Report: {{ new Date().toLocaleDateString() }}","html":"=<h1>Top 3 YouTube Videos</h1>\n<p>Here is your performance report for this period.</p>\n<ol>\n  <li>\n    <strong>Title:</strong> {{ $json.caption }}<br>\n    <strong>Score:</strong> {{ $json.performance_score }}<br>\n    <strong>Link:</strong> <a href=\"{{ $json.post_url }}\">Watch Video</a>\n  </li>\n  <li>\n    <strong>Title:</strong> {{ $json.caption }}<br>\n    <strong>Score:</strong> {{ $json.performance_score }}<br>\n    <strong>Link:</strong> <a href=\"{{ $json.post_url }}\">Watch Video</a>\n  </li>\n  <li>\n    <strong>Title:</strong> {{ $json.caption }}<br>\n    <strong>Score:</strong> {{ $json.performance_score }}<br>\n    <strong>Link:</strong> <a href=\"{{ $json.post_url }}\">Watch Video</a>\n  </li>\n</ol>","options":{"appendAttribution":false}},"type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1040,40],"id":"fabca8d6-9f3f-404f-a7d5-4b522babc64e","name":"Send YouTube Report","webhookId":"4ce9223b-96d5-467c-bda4-6b590db736e1","credentials":{"smtp":{"id":"4SUQuiP97UDGdYtA","name":"gerald@dominixai.com"}}}],"connections":{"Analytics Scheduler":{"main":[[{"node":"📋 Configuration Variables","type":"main","index":0}]]},"Initialize Variables":{"main":[[{"node":"Get Channel Info","type":"main","index":0}]]},"📋 Configuration Variables":{"main":[[{"node":"Initialize Variables","type":"main","index":0}]]},"Get Channel Info":{"main":[[{"node":"Get All Videos","type":"main","index":0}]]},"Get All Videos":{"main":[[{"node":"Normalize YouTube Data","type":"main","index":0}]]},"Normalize YouTube Data":{"main":[[{"node":"Engagement Analysis","type":"main","index":0}]]},"Engagement Analysis":{"main":[[{"node":"Send YouTube Report","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":null,"pinData":null,"versionId":"eda26db4-d714-4682-b904-560a5b9b4384","triggerCount":0,"shared":[{"createdAt":"2025-10-27T08:56:35.994Z","updatedAt":"2025-10-27T08:56:35.994Z","role":"workflow:owner","workflowId":"GuWfhVUGBwVYcraY","projectId":"roCKyeuuwaNdcgDf"}],"tags":[]}