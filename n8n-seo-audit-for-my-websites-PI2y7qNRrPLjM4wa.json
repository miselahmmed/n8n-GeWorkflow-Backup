{"createdAt":"2025-08-17T20:06:04.762Z","updatedAt":"2025-08-19T05:37:04.000Z","id":"PI2y7qNRrPLjM4wa","name":"n8n SEO Audit for my websites","active":false,"isArchived":false,"nodes":[{"parameters":{"resource":"on_page","url":"={{ $('Get row(s) in sheet').item.json.URL }}","additionalFieldsPageAudit":{}},"type":"n8n-nodes-dataforseo.dataForSeo","typeVersion":1,"position":[208,-352],"id":"f3e6e892-c1d3-4245-973a-d860e131927c","name":"Get page audit check","credentials":{"dataForSeoApi":{"id":"Dkq5hzldGliJH1l9","name":"DataForSEO account"}}},{"parameters":{"assignments":{"assignments":[{"id":"613c787d-a433-46d9-a176-2990e81a35d0","name":"inputData","value":"={{ $json.tasks[0] }}","type":"object"},{"id":"380410ac-20e4-4c12-9a37-bcba986e55f8","name":"url","value":"={{ $('Get row(s) in sheet').item.json.URL }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[432,-352],"id":"1ecfdae4-3595-41f0-a26b-2f63f11875d9","name":"Edit Fields"},{"parameters":{"modelId":{"__rl":true,"value":"o3","mode":"list","cachedResultName":"O3"},"messages":{"values":[{"content":"=You are a SEO expert working Audit datasets.\n\nFrom the {{ $json.inputData.result }} you will create a report for a SEO Page Audit.\n\nUse the page URL {{ $json.inputData.data.url }} as a reference\n== Follow these rule  ==\n- Output in HTML syntax\n- Create tables with actions to perform\n- Create tables with results\n- Create Graphs usiong Chart.js with results from {{ $json.inputData.result[0].items[0].page_timing }}\n- Create easy to understand actionable bullet lists\n- Explain in Details all technical terms like LSI, Render Blocking etc. and explain them to a 9th grader, so its easy for the reader to take action\n- Make the report look nice by applying Bulma CSS \n- My Contact information is Lennart Øster, https://lennartoester.com, and email is hi@lennartoester.com\n- Todays date and time is {{ $('Date & Time').item.json.Today }}","role":"system"}]},"options":{}},"type":"@n8n/n8n-nodes-langchain.openAi","typeVersion":1.8,"position":[-464,-672],"id":"eca0285f-be14-4577-8108-9a3ccd5d84c4","name":"Message a model","credentials":{"openAiApi":{"id":"ySmjTBAwyTsi9kbr","name":"OpenAi account"}},"disabled":true},{"parameters":{"operation":"URL/HTML to PDF","convertType":"htmlToPDF","html":"={{ $json.report }}","advancedOptions":{}},"type":"n8n-nodes-pdfco.PDFco Api","typeVersion":1,"position":[1232,-416],"id":"fa8a383e-8f8d-4852-a7b3-726f7ca1e82d","name":"PDFco Api","retryOnFail":true,"credentials":{"pdfcoApi":{"id":"c22l8I8xHDdJUjeQ","name":"PDF.co account"}}},{"parameters":{"url":"={{ $json.url }}","options":{"response":{"response":{"responseFormat":"file"}}}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1456,-416],"id":"74695be0-6d73-43ab-aa16-b929594322f5","name":"HTTP Request"},{"parameters":{"sendTo":"denorgerald@gmail.com","subject":"=Your SEO Audit Report","message":"=<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>SEO Audit Email</title>\n  </head>\n  <body style=\"font-family: Arial, sans-serif; background-color: #f9f9f9; padding: 30px; color: #333;\">\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width: 600px; margin: auto; background-color: #ffffff; border-radius: 8px; padding: 30px;\">\n      <tr>\n        <td align=\"left\">\n          <h2 style=\"margin-top: 0;\">Hi,</h2>\n          <p>\n            I’ve built an automation using <strong>n8n</strong> that runs SEO audits on websites – and I ran one for yours.<br />\n            You’ll find the full report attached.\n          </p>\n\n          <p>\n            This audit was generated automatically, so no sales pitch here. Just some potentially useful insights.\n          </p>\n\n          <p>\n            I specialize in combining SEO and automation to help businesses uncover issues, optimize workflows, and save time.\n            If you'd like help fixing anything from the audit or want to explore how automations like this could support your team\n            (think: marketing, lead gen, reporting), just hit reply. Happy to chat.\n          </p>\n\n          <p>Best regards,<br /><strong>Lennart Øster</strong><br />SEO & Automation Expert</p>\n\n          <p style=\"margin-top: 20px;\">\n            <a href=\"https://dominxai.com\" style=\"color: #1a73e8; text-decoration: none;\">lennartoester.com</a><br />\n            <a href=\"mailto:gerald@dominxai.com\" style=\"color: #1a73e8; text-decoration: none;\">hi@lennartoester.com</a><br />\n            <a href=\"https://www.linkedin.com/in/lennartoester/\" style=\"color: #1a73e8; text-decoration: none;\">Connect on LinkedIn</a>\n          </p>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n","options":{"appendAttribution":false,"attachmentsUi":{"attachmentsBinary":[{}]}}},"type":"n8n-nodes-base.gmail","typeVersion":2.1,"position":[1904,-352],"id":"b86bba56-27a6-46cf-8c61-cc3e0836dae0","name":"Send a message","webhookId":"0d48eb32-c3f6-459c-8bd7-978b047e36d8","credentials":{"gmailOAuth2":{"id":"ruloI1GkFQqksqlC","name":"denorgerald@gmail.com"}}},{"parameters":{"operation":"addToDate","magnitude":"={{ $now }}","outputFieldName":"Today","options":{}},"type":"n8n-nodes-base.dateTime","typeVersion":2,"position":[-16,-352],"id":"7153a578-a772-4b78-8576-6b1811e67513","name":"Date & Time"},{"parameters":{"promptType":"define","text":"=You are a SEO expert working Audit datasets.\n\nFrom the {{ $json.inputData.result }} you will create a report for a SEO Page Audit.\n\nUse the page URL {{ $json.inputData.data.url }} as a reference\n== Follow these rule  ==\n- Output in HTML syntax\n- Create tables with actions to perform\n- Create tables with results\n- Create Graphs usiong Chart.js with results from {{ $json.inputData.result[0].items[0].page_timing }}\n- Create easy to understand actionable bu