h item one by one.\nreturn allItems.map(item => {\n  // 1. Find and clean the raw HTML text from the AI.\n  const rawHtml = item.json.output || \"\";\n  let cleanedReport = rawHtml.replace(/```html/g, \"\");\n  cleanedReport = cleanedReport.replace(/```/g, \"\");\n\n  // 2. Prepare the final output.\n  // This new return statement creates a clean object\n  // with ONLY the original URL and the new report.\n  return {\n    json: {\n      URL: item.json.URL,\n      report: cleanedReport\n    }\n  };\n});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1008,-352],"id":"1f6acbfc-d35e-4eef-9ca8-576704f52216","name":"Data Cleaner Code"},{"parameters":{"mode":"combine","combineBy":"combineByPosition","options":{}},"type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[1680,-352],"id":"fc8b8e8e-5393-48c0-a189-14ea98d7e9b1","name":"Merge"}],"connections":{"Edit Fields":{"main":[[{"node":"AI Agent","type":"main","index":0}]]},"Message a model":{"main":[[]]},"HTTP Request":{"main":[[{"node":"Merge","type":"main","index":0}]]},"Date & Time":{"main":[[{"node":"Get page audit check","type":"main","index":0}]]},"Get page audit check":{"main":[[{"node":"Edit Fields","type":"main","index":0}]]},"OpenRouter Chat Model":{"ai_languageModel":[[{"node":"AI Agent","type":"ai_languageModel","index":0}]]},"AI Agent":{"main":[[{"node":"Data Cleaner Code","type":"main","index":0}]]},"PDFco Api":{"main":[[{"node":"HTTP Request","type":"main","index":0}]]},"Schedule Trigger":{"main":[[{"node":"Get row(s) in sheet","type":"main","index":0}]]},"Get row(s) in sheet":{"main":[[{"node":"Date & Time","type":"main","index":0}]]},"Data Cleaner Code":{"main":[[{"node":"PDFco Api","type":"main","index":0},{"node":"Merge","type":"main","index":1}]]},"Merge":{"main":[[{"node":"Send a message","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":{"templateCredsSetupCompleted":true},"pinData":{"Schedule Trigger":[{"json":{"timestamp":"2025-08-18T22:53:24.07