{"updatedAt":"2025-11-10T08:08:50.000Z","createdAt":"2025-11-10T08:06:37.098Z","id":"XrKyegPDdLAo1FLL","name":"AI Sales Agent - Main Workflow","active":false,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"whatsapp-webhook","responseMode":"responseNode","options":{}},"id":"061237a4-51cd-46be-b5e0-892bca441cd1","name":"Webhook - WhatsApp","type":"n8n-nodes-base.webhook","typeVersion":1,"position":[-16,-96],"webhookId":"df10de89-3846-45fd-a365-dca9dbf715be"},{"parameters":{"httpMethod":"POST","path":"sms-webhook","responseMode":"responseNode","options":{}},"id":"2d1cc667-6785-4a44-8286-8393ba475809","name":"Webhook - SMS","type":"n8n-nodes-base.webhook","typeVersion":1,"position":[-16,96],"webhookId":"28d24d26-651b-4832-9ed8-6a806bff5047"},{"parameters":{"httpMethod":"POST","path":"telegram-webhook","responseMode":"responseNode","options":{}},"id":"e560fa56-edcd-47b9-bb7e-687cba3b3042","name":"Webhook - Telegram","type":"n8n-nodes-base.webhook","typeVersion":1,"position":[-16,272],"webhookId":"d62d8484-5ef6-49c9-8f77-62f6e40cc1bc"},{"parameters":{"httpMethod":"POST","path":"email-webhook","responseMode":"responseNode","options":{}},"id":"27701521-6890-4070-90d1-200cb845561c","name":"Webhook - Email","type":"n8n-nodes-base.webhook","typeVersion":1,"position":[-16,448],"webhookId":"ec84f505-b0ec-468a-b5f4-e6e779e5e1e6"},{"parameters":{"httpMethod":"POST","path":"vapi-webhook","responseMode":"responseNode","options":{}},"id":"78a4288d-1423-476a-9286-d934f9014af4","name":"Webhook - VAPI","type":"n8n-nodes-base.webhook","typeVersion":1,"position":[-16,624],"webhookId":"62c48b63-086b-45ee-a278-d304d8065766"},{"parameters":{"jsCode":"// Cross-Platform Session ID Normalization\nconst items = $input.all();\nconst outputs = [];\n\nfor (const item of items) {\n  let identifier = '';\n  let chatInput = '';\n  let platform = '';\n  let rawData = item.json;\n  \n  // Detect platform and extract data\n  if (rawData.From && rawData.From.includes('whatsapp')) {\n    // WhatsApp via Twilio\n    identifier = rawData.From.replace('whatsapp:', '');\n    chatInput = rawData.Body || '';\n    platform = 'whatsapp';\n  } else if (rawData.From && rawData.Body && !rawData.message) {\n    // SMS via Twilio\n    identifier = rawData.From;\n    chatInput = rawData.Body || '';\n    platform = 'sms';\n  } else if (rawData.message && rawData.message.from) {\n    // Telegram\n    identifier = rawData.message.from.id.toString();\n    chatInput = rawData.message.text || '';\n    platform = 'telegram';\n  } else if (rawData.from && rawData.subject) {\n    // Email\n    identifier = rawData.from;\n    chatInput = rawData.body || rawData.text || '';\n    platform = 'email';\n  } else if (rawData.call && rawData.call.customer) {\n    // VAPI Voice\n    identifier = rawData.call.customer.number;\n    chatInput = rawData.transcript || '';\n    platform = 'vapi';\n  }\n  \n  outputs.push({\n    json: {\n      identifier,\n      chatInput,\n      platform,\n      rawData\n    }\n  });\n}\n\nreturn outputs;"},"id":"edd07b1b-f44a-4c8a-b745-2582d800dbc1","name":"Code - Normalize Session ID","type":"n8n-nodes-base.code","typeVersion":2,"position":[192,208]},{"parameters":{"operation":"search","base":"={{ $env.AIRTABLE_BASE_ID }}","table":"Leads","filterByFormula":"OR({Phone} = '{{ $json.identifier }}', {Email} = '{{ $json.identifier }}')","options":{}},"id":"eee77d8b-32ca-4ca5-a830-848b9c49a706","name":"Airtable - Search Lead","type":"n8n-nodes-base.airtable","typeVersion":2,"position":[384,208]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.id }}","rightValue":"","operator":{"type":"string","operation":"exists","singleValue":true}}],"combinator":"and"},"options":{}},"id":"809f2e69-507b-4817-947b-d601610ebc8b","name":"IF - Lead Exists","type":"n8n-nodes-base.if","typeVersion":2,"position":[592,208]},{"parameters":{"jsCode":"// Set Session ID based on lead data\nconst leadData = $('Airtable - Search Lead').item.json;\nconst normalizedData = $('Code - Normalize Session ID').item.json;\n\nlet sessionId;\nlet leadInfo = null;\n\nif (leadData && leadData.fields && leadData.fields.Email) {\n  // Lead exists with email - use email as session ID\n  sessionId = leadData.fields.Email;\n  leadInfo = {\n    id: leadData.id,\n    email: leadData.fields.Email,\n    firstName: leadData.fields['First Name'],\n    company: leadData.fields.Company,\n    phone: leadData.fields.Phone,\n    goal: leadData.fields.Goal,\n    blocker: leadData.fields.Blocker,\n    dreamOutcome: leadData.fields['Dream Outcome']\n  };\n} else {\n  // No lead or no email - use identifier (phone/telegram ID)\n  sessionId = normalizedData.identifier;\n}\n\nreturn {\n  json: {\n    sessionId,\n    leadInfo,\n    chatInput: normalizedData.chatInput,\n    platform: normalizedData.platform,\n    identifier: normalizedData.identifier\n  }\n};"},"id":"b0854aa6-0a4e-420e-849c-8f78739b8d09","name":"Code - Set Session ID","type":"n8n-nodes-base.code","typeVersion":2,"position":[784,112]},{"parameters":{"operation":"executeQuery","query":"SELECT * FROM chat_history WHERE session_id = $1 ORDER BY created_at DESC LIMIT 20","options":{}},"id":"547ce0b4-5951-49b1-b6e3-6f8d78643d92","name":"Postgres - Get Chat History","type":"n8n-nodes-base.postgres","typeVersion":2.4,"position":[992,112]},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.leadInfo }}","rightValue":"","operator":{"type":"string","operation":"notExists"}}],"combinator":"and"},"renameOutput":true,"outputKey":"createLead"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.leadInfo.goal }}","rightValue":"","operator":{"type":"string","operation":"notExists"}}],"combinator":"and"},"renameOutput":true,"outputKey":"gatherInfo"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.leadInfo.goal }}","rightValue":"","operator":{"type":"string","operation":"exists"}}],"combinator":"and"},"renameOutput":true,"outputKey":"productQuestions"}]},"options":{}},"id":"eb574a05-92b5-4d19-907f-33ced18a59c6","name":"Switch - Agent Router","type":"n8n-nodes-base.switch","typeVersion":3,"position":[1184,112]},{"parameters":{"method":"POST","url":"https://api.anthropic.com/v1/messages","authentication":"predefinedCredentialType","nodeCredentialType":"anthropicApi","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1000,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"You are a lead creation assistant. Your job is to collect:\\n- First Name\\n- Company Name\\n- Email Address\\n\\nCurrent message: {{ $json.chatInput }}\\n\\nIf you have all three pieces of information, respond with JSON only:\\n{\\\"hasAllInfo\\\": true, \\\"firstName\\\": \\\"...\\\", \\\"company\\\": \\\"...\\\", \\\"email\\\": \\\"...\\\"}\\n\\nOtherwise respond conversationally asking for missing information.\"\n    }\n  ]\n}","options":{}},"id":"09b0ccba-24d1-4530-96db-b9d6b04ef6f0","name":"HTTP - Agent Create Lead","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1392,-96],"credentials":{"anthropicApi":{"id":"pvdBPeu56Ea5mKrO","name":"Anthropic API account"}}},{"parameters":{"method":"POST","url":"https://api.anthropic.com/v1/messages","authentication":"predefinedCredentialType","nodeCredentialType":"anthropicApi","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1000,\n  \"messages\": {{ $json.chatHistory }},\n  \"system\": \"You are gathering information about the lead's business goals. Ask about:\\n1. Their main business goal\\n2. Their biggest blocker\\n3. Their dream outcome (specific metric)\\n\\nBe conversational and ask one question at a time. When you have all three, respond with JSON:\\n{\\\"hasAllInfo\\\": true, \\\"goal\\\": \\\"...\\\", \\\"blocker\\\": \\\"...\\\", \\\"dreamOutcome\\\": \\\"...\\\"}\"\n}","options":{}},"id":"92d49ec6-a244-423e-90ee-0dcd4e47847d","name":"HTTP - Agent Gather Info","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1392,112]},{"parameters":{"method":"POST","url":"https://api.anthropic.com/v1/messages","authentication":"predefinedCredentialType","nodeCredentialType":"anthropicApi","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1500,\n  \"messages\": {{ $json.chatHistory }},\n  \"system\": \"You are a product expert for {{ $('Airtable - Get Products').all().map(p => p.json.fields.Name).join(', ') }}.\\n\\nLead Context:\\nGoal: {{ $json.leadInfo.goal }}\\nBlocker: {{ $json.leadInfo.blocker }}\\nDream Outcome: {{ $json.leadInfo.dreamOutcome }}\\n\\nUse the RAG context below to answer questions:\\n{{ $json.ragContext }}\\n\\nIf asked to book a call, confirm budget fit first, then offer times in next 2-3 days.\"\n}","options":{}},"id":"8e85ee96-a911-4bb5-b2f6-d3bbf7a46d08","name":"HTTP - Agent Product Questions","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1392,304]},{"parameters":{"operation":"executeQuery","query":"SELECT content, metadata, source_url FROM documents WHERE product_id = $1 ORDER BY embedding <=> $2::vector LIMIT 5","options":{}},"id":"d37b4353-7581-47fa-b5f0-fd6dd9463c7d","name":"Postgres - Vector Search","type":"n8n-nodes-base.postgres","typeVersion":2.4,"position":[1184,304]},{"parameters":{"jsCode":"// Extract response and parse if JSON\nconst agentResponse = $input.item.json;\nconst responseText = agentResponse.content[0].text;\n\n// Try to parse as JSON (for structured responses)\nlet parsedResponse;\ntry {\n  parsedResponse = JSON.parse(responseText);\n} catch (e) {\n  parsedResponse = { message: responseText, hasAllInfo: false };\n}\n\nreturn { json: parsedResponse };"},"id":"6fff7d32-d592-4dff-8be2-d65041cab1e5","name":"Code - Parse Agent Response","type":"n8n-nodes-base.code","typeVersion":2,"position":[1584,112]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.hasAllInfo }}","rightValue":"true","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"id":"6ca49f4f-0f64-4e7d-bdd3-dfa6d7426e0d","name":"IF - Info Complete","type":"n8n-nodes-base.if","typeVersion":2,"position":[1792,16]},{"parameters":{"operation":"create","base":"={{ $env.AIRTABLE_BASE_ID }}","table":"Leads","columns":{"mappings":[{"id":"firstName","name":"First Name","value":"={{ $json.firstName }}"},{"id":"company","name":"Company","value":"={{ $json.company }}"},{"id":"email","name":"Email","value":"={{ $json.email }}"},{"id":"phone","name":"Phone","value":"={{ $('Code - Set Session ID').item.json.identifier }}"},{"id":"goal","name":"Goal","value":"={{ $json.goal }}"},{"id":"blocker","name":"Blocker","value":"={{ $json.blocker }}"},{"id":"dreamOutcome","name":"Dream Outcome","value":"={{ $json.dreamOutcome }}"}]},"options":{}},"id":"89d1893a-6689-415b-ada9-6f12ac0cc5ec","name":"Airtable - Create/Update Lead","type":"n8n-nodes-base.airtable","typeVersion":2,"position":[1984,-96]},{"parameters":{"operation":"executeQuery","query":"UPDATE chat_history SET session_id = $1 WHERE session_id = $2","options":{}},"id":"0d38ccc1-0755-410f-aa0b-757da4bf6fc5","name":"Postgres - Migrate Session to Email","type":"n8n-nodes-base.postgres","typeVersion":2.4,"position":[2192,-96]},{"parameters":{"operation":"executeQuery","query":"INSERT INTO chat_history (session_id, role, content, created_at) VALUES ($1, $2, $3, NOW())","options":{}},"id":"d9f480f5-13e2-41a2-ab76-4b03d72d2b54","name":"Postgres - Save User Message","type":"n8n-nodes-base.postgres","typeVersion":2.4,"po